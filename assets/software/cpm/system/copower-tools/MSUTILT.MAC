	DEFB	0	;Ј OF SECTORS ON SIDE-1
	DEFB	1	;FORP/M DES
	DEFB 080H,0,20H,0,2,0
	DEFB	0H	;SIDES  GO PARALLEL
	DEFB 01,02,05,06,09,10,13,14 ;TRANSL
	DEFB 17,18,21,22,25,26,29,30
