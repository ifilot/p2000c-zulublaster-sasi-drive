	TITLE P2000C ROM DEBUGGER
	.Z80
	.PHASE	0A00H
	EXTERNAL DRIVE,TRACK,SECTOR,HEAD
	EXTERNAL RWBUFF,RWLGT,READSEC,WRITSEC
	EXTERNAL RESULT,CORRIG,PR1,PRCONT;
	GLOBAL DINIT
X14	EQU	14
BSP	EQU	8
CR	EQU	13
LF	EQU	10
ESC	EQU	27
DELINE	EQU	24	;CTRL XCH:	CALL	NEWLI
NONCH:	LD	SP,(SPS)
	LD	A,'>'	;MON ON SCREEN
	CALL	TTYOUT
	CALL	INICUR
	CALL	STRGIN	;GET COMMANDSTRING
	LD	A,(HL)
	INC	HL
	CALL	INTERP
	JR	MONCH
;
INTERP:	CP	'C'
	JP	Z,COMPAR
	CP	'D'
	JR	Z,DFUNCT
	CP	'G'
	JP	Z,GO
	CP	'M'
	JR
STPCHR	EQU	19	;CTRL S
DISBUF	EQU	4000H
KEYST	EQU	0F606H
KEYIN	EQU	0F609H
;
BUFRNG	EQU	0FC00H		;CP/M BUFFER RANGE
SPS	EQU	BUFRNG+10H
STADR	EQU	SPS+2
DLGTH	EQU	STADR+2
ISA	EQU	DLGTH+2
CURS	EQU	ISA+2
LINBEG	EQU	CURS+1
INBUFF	EQU	LINBEG+2
;
MEMM	Z,MOVE
	CP	'P'
	JP	Z,PFUNCT
	CP	'S'
	JP	Z,SFUNCT
	CP	'F'
	JP	Z,FILLL
CMDERR:	CALL	NEWLI
	LD	A,'?'
	CALL	TTYOUT
	JR	NONCH
;
SKIPER:	CALL	SKIP
	RET	NC
	JR	CMDERR
;
DFUNCT:	CALL	SKIP
	JP	C,DUMP
	LD	A,(HL)
	CP	'R'
	JR	Z,DISKF
	CP	'W'
	JPGR	EQU	1EH
MEXTP	EQU	0FFH
SIO	EQU	28H
USART3	EQU	10H

DINIT:	LD	IX,BUFRNG	;1ST FREE PLACE
	LD	SP,BUFRNG
	LD	HL,INIBL
	LD	DE,DRIVE
	LD	BC,9
	LDIR
	LD	(IX+X14),2	;DISABLE PRINT
	SU¬	A
	LD	(CORRIG+1),A	;NO RAM SWITCH
	CPL			;SEND MESSAGE
	LD	(P	NZ,DUMP
DISKF:	CALL	NEWLI
	PUSH	AF
	INC	HL
	CALL	SKIPER
	LD	A,(HL)		;GET DRIVE
	DEC	A
	PUSH	AF
	CP	'8'
	JR	NZ,DISF0
	OR	0FFH
	JR	DISF05
DISF0:	AND	3
DISF05:	LD	(DRIVE),A
	POP	AF
	AND	4
	RRCA
	RRCA
	LD	(HEAD),A
	CALL	DIG?
	DEC	A
	CP	9RCONT),A	;IF NO PRINTER
	LD	(SPS),SP
	LD	HL,DBI1
	LD	DE,INBUFF
	LD	BC,DBI2-DBI1
	LDIR
	JP	INBUFF
DBI1:	LD	HL,0
	LD	BC,1000H ;COPY TO CACHE RANGE
	LD	DE,0E000H
	PUSH	DE
	PUSH	BC
	PUSH	HL
	LDIR
	LD	A,8H
	OUT	(MEXTP),A
	POP	DE
	POP	BC
	POP	H
	JR	NC,CMDERR
	INC	A
	CALL	DIG?		;TRACK 1ST DIG
	JR	C,CMDERR
	LD	C,A
	RLCA
	RLCA
	ADD	A,C
	RLCA
	LD	B,A
	CALL	DIG?
	DEC	HL
	JR	C,DISF1
	INC	HL
	ADD	A,B
	LD	C,A
DISF1:	LD	A,(DRIVE)
	CP	0FFH		;HARD DISK?
	JR	Z,DISF15
	LD	A,80		;MAX TRACK L
	LDIR
	LD	A,0
	OUT	(MEXTP),A
	JP	DBI2
DBI2:	LD	HL,DISBUF
	LD	(STADR),HL
	LD	H,1
	LD	(DLGTH),HL	;SEE 1 SECTOR
	LD	HL,COMMX	;COMMANDS:
	CALL	LINOU		;C,D,DR,DW,F,
	JP	MONCH		;G,M,P,PS,S,SX
;
MOVR:	CALL	SKIPER
	CALL	GETADD
	PUSH	DE		;SOURCE ADNUM
	CP	C
	JP	C,CMDERR
DISF15:	LD	A,C
	LD	(TRACK),A
	LD	A,(HL)
	CP	CR
	INC	HL
	LD	DE,DISBUF
	CALL	NZ,GETADD
	LD	(RWBUFF),DE
	LD	(STADR),DE	;MODIFY DUMP
DISF18:	POP	AF
	PUSH	AF
	CP	'R'
	LD	A,(CURS)
	PUSH	AF
	JR	NZ,DISF2
	CALL	READSEC		;READR
	CALL	SKIPER
	CALL	GETADD
	PUSH	DE		;END ADDR
	CALL	SKIPER
	CALL	GETADD		;DE=DESTINATION
	POP	HL		;END ADDRESS
	POP	BC		;START ADDRESS
	AND	A		;CHECK IF END>SOURCE
	SBC	HL,BC
	INC	HL
	JR	C,CMDERR
	PUSH	HL
	PUSH	BC
	POP	HL		;HL=SOURCE
	POPD TRACK
	CALL	SAVKEY		;IF KEY DEPR
	JR	DISF3
DISF2:	CALL	WRITSEC
	CALL	SAVKEY		;IF KEY DEPR
DISF3:	JR	NZ,DISF4
	LD	HL,OKX
	CALL	LINOU
	JR	DISF8
DISF4:	LD	B,7
	LD	DE,RESULT
DISF5:	PUSH	BC
	LD	A,(DE)
	INC	DE
	CALL	DSPBTE
	CALL	DSPSBL
	POP	BC		BC		;BC=LENGTH
	RET
;
COMPAR:	CALL	MOVR		;GET PARAMETER
	CALL	NEWLI
C11:	LD	A,B
 	OR	C
	RET	Z
	LD	A,(DE)
	CP	(HL)
	JR	Z,COK
	CALL	CCDIS
	CALL	CCDIS
	CALL	DSPDBL
COK:	DEC	BC
	INC	HL
	INC	DE
	JR	C11
	;
MOVE:	CALL	MOVR		;GET PARAMETERS
	L
	DJNZ	DISF5
DISF8:	CALL	DSPSBL
	POP	AF
	LD	(CURS),A
	EX	AF,AF'
	JR	Z,DISF18
	POP	AF
	RET
SAVKEY:	EX	AF,AF'
	CALL	KEYST
	JR	Z,SAVK1
	CALL	KEYIN
	OR	0FFH	;THROW AWAY
SAVK1:	EX	AF,AF'
	RET
;
DIG?:	LD	A,(HL)
	INC	HL
	SUB	'0'
	CP	10
	CCF
D	A,B
	OR	C
	RET	Z		;NO MOVE
	PUSH	HL
	AND	A
	SBC	HL,DE		;DEST HIGHER?
	POP	HL
	JR	NC,MOV1		;SIMPLE LDIR
	ADD	HL,BC
	DEC	HL
	PUSH	HL		;HL=HL+BC-1
	EX	DE,HL
	ADD	HL,BC
	DEC	HL
	EX	DE,HL		;DE=DE+BC-1
	POP	HL
	LDDR
	RET
;
MOV1:	LDIR
;
MON	RET
;
; ***DISPLAY MEMORY***
;
DUMP:	CALL	SKIP
	LD	DE,(STADR)
	CALL	NC,GETADD	;GET STARTADDR
	CALL	SKIP
	PUSH	DE		;SAVE STARTADDR
	JR	C,DUMP0		;NO ENDADR
	CALL	NC,GETADD	;GET END ADDR
	INC	DE
	POP	HL
	PUSH	HL		;DE = END ADDR
	EX	DE,HL
	AND	A
	SBC	HL,DE
	LD	(DLGTH),HL	;LGTH
DUMP0:	LD	HL,(DLGTH)
	EX	DE,HL		;DE = LENGTH
	POP	HL		;HL = STARTADDR
	CALL	NEWLI
NEROW:	CALL	DSPADD
	CALL	DSPDBL
	LD	(ISA),HL
	LD	B,16		;16 BYTE/ROW
NDMP:	LD	A,(HL)
	INC	HL
	CALL	DSPBTE		;DISPLAY DATA
	LD	A,)
	CALL	DSPBTE
	INC	C
	JR	Z,PMR		;READY
	DJNZ	ALLP3
	JR	ALLP2
;
SFUNCT: LD	A,(HL)
	CP	'K'
	JP	NZ,ALTER
;
;SEEK FOR A STRING
	INC	HL
	CALL	SKIPER
	CALL	NEWLI
	LD	B,0
	PUSH	HL
	LD	HL,INBUFF
	EX	(SP),HL
SE1:	CALL	GETBTE	;GET BYTE TO SEEK
	E
	RES	0,A
	OR	D		;LAST BYTE?
	JR	NZ,NDMP3
	LD	(STADR),HL
	LD	DE,(DLGTH)	;LGTH
	ADD	HL,DE
	CALL	BTEST9
	DEC	B
	JR	Z,NDMP2
NDMP1:	CALL	DSPDBL
	CALL	BTEST9
	CALL	DSPSBL
	DJNZ	NDMP1
NDMP2:	CALL	DSPSBL
	CALL	DUAS
	JP	NONCH
NDMP3:	DEC	DE
	CALLEX	(SP),HL
	LD	(HL),A	;SAVE
	INC	HL
	INC	B
	EX	(SP),HL
	CALL	SKIP
	JR	NC,SE1
	POP	HL
	LD	DE,0
SE2:	PUSH	BC
	PUSH	DE
	LD	HL,INBUFF
SE3:	LD	A,(DE)
	CP	(HL)
	JR	NZ,SE4
	INC	DE
	INC	HL
	DJNZ	SE3
	POP	HL
	PUSH	HL
	LD	BC,INBUFF
	SBC	HL,BC
		DSPSBL
	CALL	BTEST9	;EXTRA MID-SPACE
	DJNZ	NDMP	;REPEAT LOOP
	CALL	DUAS
	JR	NEROW
;
DUAS:	CALL	DSPDBL	;SHOW ASCII LINE
	LD	B,16
	LD	A,'*'
	CALL	TTYOUT
	LD	HL,(ISA)
DUAS1:	LD	A,(HL)	
	INC	A
	AND	7FH
	C–	21H
	LD	A,(HL)
	INC	HL
	JR	NC,$+4
	ADD	HL,BC
	CALL	NZ,DSPADD
	CALL	NZ,DSPSBL
SE4:	POP	DE
	POP	BC
	INC	DE
	LD	A,D
	OR	E
	JR	NZ,SE2
	RET
;
;	***FILL***
;
FILLL:	CALL	MOVR
FILL1:	LD	(HL),E
	INC	HL
	DEC	BC
	LD	A,B
	OR	C
	RET	Z
	JR	FILL1
;
;
;	***SUBROUTINES***
LINOU:	LD	LD	A,'.'
	CALL	TTYOUT	;DISPLAY ASCII
	DJNZ	DUAS1
	LD	A,'*'
	CALL	TTYOUT
	JP	NEWLI
;
ALTER:	CALL	SKIPER
	CALL	GETADD
ALT1:	CALL	NEWLI
	EX	DE,HL	;DISPLAY ADDRESS
	CALL	DSPADD
	EX	DE,HL
	LD	A,(DE)
	CALL	DSPDBL
	CALL	DSPBTE
	CALL	DSPDBL
	CALL	A,(HL)
	CP	'$'
	RET	Z
	CALL	TTYOUT
	INC	HL
	JR	LINOU
SCROLL:	PUSH	AF
	LD	A,CR
	CALL	VIDOUT
	LD	A,LF
	CALL	VIDOUT
	POP	AF
	RET
;
SCROUT:	CP	BSP
	JR	NZ,SC0
SCB:	LD	HL,CURS
	INC	(HL)
	DEC	(HL)
	RET	Z
	DEC	(HL)
	PUSH	AF
	LD	A,BSP
	CALL	VINICUR
	CALL	STRGIN	;GET NEW DATA
	LD	A,(HL)
	CP	'.'	;FINISH SEQUENCE
	RET	Z
	CP	CR
	JR	Z,INCADD ;NO DATA CHANGE
	CALL	GETBTE
	LD	(DE),A
INCADD:	INC	DE	;UPDATE ALTER-POINTER
	JR	ALT1	;REPEAT SEQUENCE
;
GO:	CALL	SKIPER
	CALL	GETADD
	EX	DE,HL
IDOUT
	LD	A,' '
	CALL	VIDOUT
	LD	A,BSP
	CALL	VIDOUT
	POP	AF
	RET
SC0:	CP	7		;BELL
	JP	Z,VIDOUT
SC1:	CP	DELINE		;DELETE LINE?
	JR	NZ,SC2
SCD:	CALL	SCB
	JR	NZ,$-3
	RET
SC2:	CP	LF
	JR	NZ,SC3
SCLF:	CALL	SCROLL
	JR	SCD
SC3:	CP	CR
	JR	NZ,SC5
	JP	(HL)
;
PFUNCT:	CALL	NEWLI
	LD	A,(HL)
	CP	CR
	JP	Z,ALLPOR
	CP	'S'		;PR SWITCH
	JR	NZ,PORT
	LD	A,(IX+X14)
	XOR	2	;CHANGE PR CONTROL BIT
	LD	(IX+X14),A
	JP	NONCH
;
PORT:	CALL	SKIPER
	CALL	GETBTE		;GET PORT #
	LD	C,A
POR1:	LD	A,'P'
	CALL	TSC4:	LD	A,CR
	CALL	VIDOUT
SC44:	SUB	A
	LD	(CURS),A
	RET
SC5:	CALL	VIDASC
	LD	HL,CURS
	LD	A,(HL)
	CP	79
	JR	Z,SC8	;LINE FULL, DO LF
	INC	(HL)
	RET
SC8:	CALL	RETLF
	JR	SC44	;INIT CURS
;
;OUTPUT TO SCREEN (AND PRINTER) FROM 'A'
;CONTROL IN IX+TYOUT
	LD	A,C
	CALL	DSPBTE
	CALL	DSPSBL
	IN	A,(C)
	CALL	DSPBTE
	CALL	DSPSBL
	CALL	STRGIN		;GET CHANGING
	LD	A,(HL)
	CP	'.'
PMR:	RET	Z		;ENOUGH
	CP	CR
	JR	Z,PMN		;NO CHANGE
	CALL	GETBTE
	OUT	(C),A
PMN:	CALL	NEWLI
	INC	C
	JR	POR1
;
;DISPLA4:
;BIT0=1 IF TTYOUT SHOULD DISPL CONTROL CHAR TOO
;BIT1=1 IF TTYOUT SHOULD PRINT TOO
TTYOUT:	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	AND	7FH	;REMOVE BIT7
	CALL	PRINT1	;PRINT,TOO
	POP	AF
	PUSH	AF
	CALL	SCROUT
	CALL	KEYST
	JR	Z,TTYO3
	CALL	KEYIN
Y ALL PORT READ DATA (00 TO FF)
ALLPOR:	CALL	DSPSBL
	CALL	DSPDBL
	SUB	A
ALLP1:	CALL	DSPDBL
	CALL	DSPDIG
	INC	A
	CP	10H
	JR	NZ,ALLP1
	LD	C,0
ALLP2:	CALL	NEWLI
	LD	B,10H
	LD	A,'P'
	CALL	TTYOUT
	LD	A,C
	CALL	DSPBTE
ALLP3:	CALL	DSPSBL
	IN	A,(C	CP	STPCHR
	JP	NZ,CMDERR	;EXIT
	CALL	KEYIN		;GET NEXT KEY
	CP	STPCHR
	JP	NZ,CMDERR
TTYO3:	POP	AF
TTYRET:	POP	HL
	POP	DE
	POP	BC
	RET
;
TTYIN:	PUSH	BC
	PUSH	DE
	PUSH	HL
TTI1:	CALL	CURP		;GET CURSOR POS
	CALL	KEYIN
SC9:	CP	'@'
	JR	C,TTYRET
	RES	5,A
	JR	TTYRET
;
CURP:	PUSH	AF
	LD	A,(CURS)
	LD	HL,(LINBEG)	;LINE BEGIN
	ADD	A,L
	LD	L,A
	POP	AF
	RET
;
STRGIN:	PUSH	AF		;STRING INPUT
	LD	HL,INBUFF
NCH:	PUSH	DE
	LD	DE,INBUFF+4EH
	LD	A,E
	POP	DE
	CP	L
	LD	A,CR
	JR	Z,NCH1		;LENGTH R
;
DSPADD:	PUSH	AF
	LD	A,H
	CALL	DSPBTE	;DISPLAY FIRST BYTE
	LD	A,L
	CALL	DSPBTE	;DISPLAY SECOND BYTE
	POP	AF
	RET
;
SHFTDG:	RRCA
	RRCA
	RRCA
	RRCA
	AND	0FH
	RET
;
INICUR:	CALL	CURP
	LD	(LINBEG),HL
	SUB	A
	LD	(CURS),A
	RET 
;
JPDE:	EEACHED
	CALL	TTYIN
	CALL	TTYOUT
NCH1:	LD	(HL),A
	CP	BSP
	JR	Z,DECHL
	INC	HL
	JR	INCHL
DECHL:	PUSH	DE
	LD	DE,INBUFF
	LD	A,E
	POP	DE
	CP	L
	JR	Z,NCH
	DEC	HL
	JR	NCH
;
INCHL:	CP	DELINE
	JR	NZ,NOCL
	LD	HL,INBUFF ;RESET STRINGPOINTER
NOCL:	CX	DE,HL
JPHL:	JP	(HL)
;
VIDASC:	RES	7,A
	CP	20H
	JR	NC,VIDOUT
	LD	A,' '
;
VIDOUT:	PUSH	AF
VIDO1:	IN	A,(SIO+3)
	BIT	2,A
	JR	Z,VIDO1
	POP	AF
	OUT	(SIO+2),A
	RET
;
ESCAPE:	PUSH	AF
	LD	A,ESC
	CALL	VIDOUT
	POP	AF
	JR	VIDOUT
;
CONVRT:	AND	0P	CR
	JR	NZ,NCH	  ;REPEAT INPUT
	LD	HL,INBUFF
	POP	AF
	RET
;
SKIP:	PUSH	BC
	LD	C,A
	LD	B,20	;LENGTH OF INPUT BUFFER
SEEEK:	LD	A,(HL)
	CP	CR	;IF CR SET CARRY
	SCF
	JR	Z,FINSK
	CP	' '
	JR	Z,SEEEL
	CP	2CH		;COMMA?
	JR	NZ,FINSK
SEEEL:	INC	HL
FH
	OR	30H	;CONVERT TO ASCII
	CP	3AH
	RET	C
	ADD	A,7
	RET
;
RETLF:	LD	A,CR
	CALL	PRINT1
	LD	A,LF
;
PRINT1:	BIT	1,(IX+X14)
	RET	NZ
	PUSH	BC
	LD	C,A
	CALL	PR1
	POP	BC
	RET
;
PRIERR:	DEFM	'PRINTER ERROR$'
COMMX:	DEFB	0DH,0AH,0AH,'COMMANDS:	DJNZ	SEEEK
	JP	CMDERR
FINSK:	LD	A,C
	POP	BC
	RET
;
GETDIG:	LD	A,(HL)	;GET DIGIT FROM INPUT BUFFER
	CP	'0'	;& CONVERT INTO HEX
	JR	C,LDGZR
	CP	'9'+1
	JR	C,NOSUB
	CP	'A'
	JR	C,LDGZR
	CP	'F'+1
	JR	NC,LDGZR
	SUB	7
NOSUB:	AND	0FH
	INC	HL
	SCF C,D,DR,DW,F,G,M,P,PS,S,SK'
	DEFW	0A0DH
	DEFM	'ENTRY: Command Start_addr End_addr Other_info'
	DEFW	0A0DH
	DEFB	'$'
OKX:	DEFM	'OK$'
;
INIBL:	DEFB 0	;DRIVE
	DEFW 0	;TRACK
	DEFB 1	;SECTOR
	DEFB 0	;HEAD
	DEFW 1000H	;BUFF
	DEFW 0FFFH	;RWLGT-1
	END
	RET		;RETURN	WITH CARRY
LDGZR:	XOR	A	;CLEAR A
	RET		;RETURN	WITHOUT CARRY
;
GETBTE:	PUSH	DE	;GET BYTE FROM INPUT
	CALL	GETADD	;BUFFER
	LD	A,E
	POP	DE
	RET
;
GETADD:	PUSH	AF	;GET ADDRESS 
	PUSH	BC	;FROM INPUT BUFFER
	LD	DE,0
	CALL	GETDIG
NX
COMMX
ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееTDGT:	OR	E	;GET DIGITS
	LD	E,A
	CALL	GETDIG
	JR	NC,OUTLP ;NO MORE DIGITS IN STRING
	LD	B,4
SHIFTS:	SLA	E	;SHIFT DIGIT
	RL	D
	DJNZ	SHIFTS
	JR	NXTDGT
OUTLP:	POP	BC
	POP	AF
	RET
;
BTEST9:	LD	A,B	;IF B=9 5,13
	CP	9	;MAKE EXTRA SP
	JR	Z,DSPSBL
	ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееCP	5
	JR	Z,DSPSBL
	CP	13
	JR	Z,DSPSBL
	RET
;
DSPDBL:	CALL	DSPSBL
DSPSBL:	PUSH	AF
	LD	A,' '
	CALL	TTYOUT
	POP	AF
	RET