	.Z80
;INITIALIZE DISK PARAMETERS
;
DPARIN:	LD	HL,(PAR)
	LD	BC,1BH
	ADD	HL,BC
	LD	(DSKFLG),HL	;ADDR OF DSKFLAG
	INC	HL
	LD	(DMADR),HL	;DMA SHADOW
	LD	C,11H
	ADD	HL,BC		;ADR OF RESULT
	LD	(RESADR),HL
;
	LD	DE,DRIVE
	LD	HL,DUPDAT
	LD	BC,LASBUFL),A	;TRACK NUMB
	LD	HL,(DSKFLG)
	BIT	NOTRDY,(HL)	;BIT-4
;
	JR	Z,D2KEY	;
	LD	A,2AH	;'DISK NOT READY!'
DISKER:	PUSH	AF
	CALL	LASPRI
	POP	AF
	CALL	TXSEEK
	CALL	DELLST
	LD	DE,L22
	CALL	TX1	;DISPL MESSAGE
	CALL	LASPRI	;PRINT IT
	CALL	RETLF
	CALL-DUPDAT
	LDIR		;UPDATE PARAMETER
	PUSH	IX
	POP	HL
	LD	C,13
	CALL	DEL
	LD	HL,RANDOM+1
	INC	(HL)
	RET
;
DUPDAT:	DEFB	0	;DRIVE
	DEFW	0	;TRACK
	DEFB	1	;SECTOR
	DEFB	0	;HEAD
	DEFW	DISBUF	;BUFF ADDR
	DEFW	0FFFH	;BUFF LENGTH
	DEFW	L22	;TXPOIN
	DE	ONEKEY
	DI
	LD	SP,(SPS)
	DEC	SP
	DEC	SP
	EI
	OR	0FFH
	RET
;
D2KEY:
;	LD	HL,9FDFH
;	LD	DE,9FFFH
;	LD	BC,0FE0H
;	LDDR
;	LD	HL,(PAR)
;	LD	DE,9000H
;	LD	BC,20H
;	LDIR
	CALL	KEYST
	JR	Z,NOEXIT
	CP	'0'
	JR	Z,KEYSTP
	CP	3
	JR	Z,KEYSTP
	CPFW	0	;BADOPC
	DEFW	0	;TOTERC
	DEFB	0	;TESPAT
	DEFW	DRLIST	;DRPT
	DEFW	-1	;DRLIST
	DEFW	-1
	DEFB	81H	;SIDEFL:SINGLE SIDED
	DEFB	28H	;MAX 40 TRACKS
	DEFW	0	;ERROR COUNTER
	DEFB	1	;REPEAT NUMB ON ERROR
	DEFB	10H	;NUMBER OF SECTORS
LASBUF:
;
;****	ESC
	JR	NZ,NOEXIT
KEYSTP:	LD	A,2DH	;STOPPED FROM KEYB
	JR	DISKER
NOEXIT:	CALL	NZ,BEEP
	POP	AF	;ERR CODE
	RET
;
TRANS:	LD	HL,DRIVE
	LD	DE,(PAR) ;DRIVE IN BIOS
	LD	BC,9	 ;TRANSFER ALL INFD
	LDIR
	RET
;
;*********** S E E K ***********
STEPTR:****** WRITE ONE SECTOR *********
;
WRITS:	LD	HL,0FFH
	JR	WRITH
;
;********** WRITE ONE TRACK **********
;
WRITE:	LD	HL,0FFFH	;LENG6TH-1
	LD	A,1
	LD	(SECTOR),A
	JR	WRITH
;
;********** READ ONE SECTOR **********
;
READ:	LD	HL,0FFH		;LENGTH-1
	LD	(TRACK),A ;REQUIRED TRACK
SEEK:	LD	BC,0DH
	JR	ROMCALL
;
;*********** STEP TO TRACK 0 ***********
RESTOR:	LD	BC,0FH
ROMCALLє LД	(DSTACK+14H),SP
	PUSH	BC
	CALМ	TRANS
	POР	BC
	LD	SP,DSTACK+14H
	LD	HL,(PAR)
	ADD	HL,BC
	LD	C,(HL)
	INC	HL
	LD		JR	READH
;
;********** READ A TRACK **********
;
RDTR:	LD	HL,0FFFH
	LD	A,1
	LD	(SECTOR),A
;
;=============================================
;READH AND WRITH ARE THE DISK HANDLER SUBR'S
;ON ENTRY: HL=TRANSFER LENGTH-1 (MAX 0FFH)
;	  THE FOLLOWINGB,(HL)
	PUSH	BC		;SUBR ADDR
	LD	BC,23H
	LD	HL,(PAR)
	ADD	HL,BC		;MSWBYT
	SUB	A
	DI
	OUT	(MEMMGR),A	;SWITCH TO PROM
	LД	(HL),Б	    ;MARЛ FOТ INTERRUPT
	EI
	EX	(SP),HL
	CALМ	JMPHL
	POP	HL		;MSWBYT
	PUSH	AF
	LД	A,2
	DI
	OUT	(MEMMGR),A
	LД	(HL BYTES MUST BE FILLED:
;	  DRIVE,TRACK,SECTOR,HEAD,RWBUFF,RWLGT
;IF DRIVE < 8,   FLOPPY IS SELECTED,
;		 OTHERWISE THE HARD DISK
;ON EXIT: A = 0 IF OK
;	  AT FLOPPY CALLS THE 7 "RESULT" BYTES
;	  ARE FILLED ACCORDING TO THE UPD765
;	  FLOPPY CONTROL),Б		;SWITCИ BACK
	EI
	POP	AF
	POP	HL
	LД	SP,HL
RETURN:	RET
JMPHL:	JP	(HL)
;
;************* READ ID *****************
READID:	LD	HL,RDIDPA+2
	LD	A,(DRIVE)
	LD	(HL),A
	DEC	HL
	DEC	HL
	CALL	OUT
	CALL	INTWAI
	LD	B,7
	CALL	INP
	JP	RW2		;ERRORLER SPECS.
;=============================================
READH::	LD	BC,09	;ADDR OFFS IN PAR BL
	JR	RW0
;
WRITH::	LD	BC,0BH		;ADDR OFFSET
RW0:	LD	(RWLGT),HL	;TRANSF LENGTH
	LD	HL,(PAR)	;PR BL ADDRESS
	ADD	HL,BC
	LD	C,(HL)
	INC	HL
	LД	B,(HL©		;SU?
RDIDPA:	DEFB	2
	DEFB	4AH
	DEFB	0
;
;STATUS
STATE:	LD	A,(DRIVE)
	LD	(STACO+2),A
	LD	HL,STACO
	CALL	OUT
	INC	B	;GET 1 BYTE
	CALL	INP
	RET
STACO:	DEFB	2	;CONTROL BLOCK FOR
	DEFB	4	;STATUS COMMAND
	DEFB	0	
;
OUT:	LD	A,(DRIVE)
	CP	3	;DRIVE-4BТ ADDRESS
	PUSH	BC
	CALL	TRANS	;TRANSFER PARAMETER
	POP	HL
	CALL	JMPHL 
RW2є	LD	HL,(RESADR)
	LD	A,(HL)
	AND	0C0H	;ERROR?
	PUSH	AF
	LD	DE,RESULT
	LD	BC,7
	LDIR		;TANSFER RESULT BYTES
	LД	A,(RESULT+1)
	LД	(STR1M),A
	LД	A,(RESULT+3)
	LD	(TRESU?
	LД	A,30H
	JR	NZ,OUT0
	OR	40H	;ENABLE DRIVE-4 TOO
OUT0:	OUT	(FDCWRO),A
	PUSH	HL
	LD	HL,(DSKFLG)
	RES	4,(HL)	;'DISK NOT RDY' FLAG
	RES	0,(HL)	;RESET INTERR FLAG
	CALL	TIMY
	POP	HL
	LD	B,(HL)
OUT1:	INC	HL
	LD	DE,0E080H
	CALL	WAIT
	RET	C
	LD	A,(HL)
	OUT	(FDDAT),A
	DJNZ	OUT1
	RET
;
INP:	LD	HL,(RESADR)	;GET RESULT
	CALL	TIMY
INP1:	LD	DE,0E0C0H
	CALL	WAIT
	RET	C
	IN	A,(FDDAT)
	LD	(HL),A	
	INC	HL
	DJNZ	INP1
	RET
;
WAIT:	IN	A,(FDSTAT)
	AND	D
	CP	E
	RET	Z
	CALL	TIMOUT
	RET	C
	ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееJR	WAIT
;
TIMY:	PUSH	HL
	LD	HL,4000H
	LD	(TIME+1),HL
	LD	(TIME),HL
	POP	HL
	RET
;
TIME:	DEFB	0,0,0
TIMOUT:	PUSH	HL
	LD	HL,(TIME)
	DEC	HL
	LD	(TIME),HL
	LD	A,H
	OR	L
	JR	NZ,TIM3
	LD	HL,TIME+2
	OR	(HL)
	JR	Z,TIM2		;INTERNAL CALL
	CALL	TIMееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее