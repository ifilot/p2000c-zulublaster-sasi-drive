HDFOR:	CALL	CLSCR
;
;FILL 100H OF DISBUF WITH E5 AS FORMAT PATTERN
	LD	HL,DISBUF
	LD	DE,DISBUF+1
	LD	BC,0FFH
	LD	(HL),0E5H
	LDIR
;
	LD	A,8
	OUT	(SASICO),A	;RESET SASI
	LD	DE,0
	CALL	TX3
	DEFB	41H		;HEADER
	LD	DE,L02
	CALL	TX3
	DEFB	43H		;'W;
;SEE IF BAD TRACKS
	AND	A
	JP	Z,HF20		;NO BAD TRACKS
	LD	HL,(WORBUF+2)
	LD	(TRACK),HL
	LD	A,(WORBUF+4)
	LD	(TRACK+2),A
;
HF12:	CALL	DECTR		;GET NEXT TRACK
	LD	(IX+6),0FFH	;NO TIMOUT
	LD	A,5
	LD	HL,0FFFFH
	CALL	XRWPRO
	JR	NZ,HF12		;BAD
;
	HICH DRIVE?'
HF2:	CALL	GETKEX
	CP	'1'
	JR	Z,HF3
	CP	'2'
	JR	Z,HF3
	CALL	BEEP
	JR	HF2
HF3:	PUSH	AF
	CALL	VIDOUT	;DISPLAY
	POP	AF
	SUB	'1'
	CPL
	LD	(DRIVE),A
	LD	HL,0
	LD	(TRACK),HL
	SUB	A
	LD	HL,0FFFFH
	CALL	XRWPRO		;SEE IF READY
	JR	Z,HFLD	A,(TRACK+2)
	LD	B,A		;HI ADDR
	POP	DE		;GET NEXT BAD TRACK
	POP	BC		;B=LO ADDR
	LD	HL,(TRACK)
	LD	A,L
	CP	E
	JR	Z,HF13		;CHECK LOWER BYTE
	JR	C,HF20		;GOOD OVER BAD
	JR	HF16
HF13:	LD	A,H
	CP	D
	JR	Z,HF14
	JR	C,HF20
	JR	HF16
HF14:	LD	A,(TR35
HF0:	CALL	LASTEX
	DEFB	42H		;'HDISK NOT RDY'
	CALL	ANYKEY
	JP	CONT
HF35:	LD	DE,L04
	CALL	TX3
	DEFB	44H		;WARNING
	LD	A,45H		;POINTS TO 'YES'
	CALL	TXSEEK
	LD	B,(HL)
HF4:	PUSH	BC
	PUSH	HL
	CALL	GETKEX
	POP	HL
	RES	5,A
	INC	HL
	CP	(HL)		;ACK+2)
	DEC	A
	CP	B
	JR	C,HF20
HF16:	EXX
	LD	HL,(TRACK)
	LD	(DISBUF),HL
	LD	DE,(TRACK+2)
	LD	A,E
	LD	(DISBUF+2),A
	EXX
	LD	(TRACK),DE
	LD	A,B
	LD	(TRACK+2),A	;SET BAD TRACK
	LD	HL,2
	LD	B,80H	;OUT 3 BYTES
	LD	A,0EH	;FORMAT ALTERNATE TRACK
TYPE 'YES'
	JP	NZ,CONT
	PUSH	HL
	CALL	VIDOUT
	POP	HL
	POP	BC
	DJNZ	HF4
;
	LD	B,80H		;WRITE
	LD	HL,0FFH		;LENGTH-1
	LD	A,0FH		;WR SECT BUFF
	CALL	XRWPRO
	LD	DE,L08
	CALL	TX3
	DEFB	47H		;TIME WARNING
	LD	HL,XEBEC+4
	LD	(HL),0		;INTERLEAVE
	IHF17:	CALL	XRWPRO	;IF ERROR, BAD LUCK!
	EXX
	LD	(TRACK),HL
	LD	A,E
	LD	(TRACK+2),A
	DEC	(IX)
	JR	NZ,HF12	;NEXT
;
;DISPLAY THE TOTAL FREE PLACE
HF20:	LD	DE,L16
	CALL	TX3
	DEFB	49H	;'DISK CAPACITY'
	LD	HL,(ERCOUN) ;£ OF GOOD BLOCKS
	ADD	HL,HL
	NC	HL
	LD	(HL),20H	;PATTERN FROM BUFFER
	LD	A,4		;DO FORMAT
	LD	HL,0FFH		;LENGTH
	LD	B,40H
	DEC	(IX+6)		;NO TIMOUT
	CALL	XRWPRO
	INC	(IX+6)		;ACTIVATE TIMOUT
	LD	B,40H		;READ
	LD	HL,3		;4 BYTES
	LD	A,3		;GET STATUS
	CALL	XRWPRO
	LD	HL,(DISBUF+1ADD	HL,HL	;TO GET IN KBYTES
	ADD	HL,HL	;MULTIPLY BY 8
	LD	BC,10000
	LD	A,0FFH
HF21:	INC	A
	SBC	HL,BC
	JR	NC,HF21
	ADD	HL,BC
	AND	A
	JR	Z,HF22
	ADD	A,'0'
	CALL	SCRODE
	INC	DE
HF22:	CALL	DEC4
	JP	EXIT
;
;
;===================================)
	RES	5,L		;DELETE 'DRIVE' BIT
	LD	(WORBUF+2),HL	;H=MID L=HI ADDR
	LD	(TRACK),HL
	LD	A,(DISBUF+3)	;LOW ADDR
	AND	0E0H		;REMOVE GARBAGE
	LD	(WORBUF+4),A	;SAVE HIGHEST TRACK+1
	LD	(TRACK+2),A
	LD	DE,L11
	CALL	TX3
	DEFB	48H		;'CHECKING'
	LD	SP,DIS==========
;PREPARE COMMAND TO XEBEC CONTROLLER
;ON ENTRY: A	   = COMMAND CODE
;	   HL	   = TRANSFER LGTH-1
;	   B	   = 40H IF READ, 80H IF WRITE
;	   (DRIVE) = DRIVE NUMBER
;	   (TRACK) = TRACK NUMBER
;=============================================BUF+4000H	;NO STACK OVERF
;
;COMPUTE NEXT LOG. ADDRESS
HF5:	CALL	DECTR		;DECREMENT TRCK
	JR	Z,HF7		;READY
	LD	A,5		;CHECK FORMAT
	LD	HL,0FFFFH
	CALL	XRWPRO
;	CALL	KEYST		;REMOVE !!!
	LD	HL,(ERCOUN)	;£ OF GOOD BLOCKS
	INC	HL
	JR	Z,HF6		;OK
	DEC	
XPREP:	LD	(XEBEC),A ;PARAM FIELD
	LD	(RWLGT),HL
	LD	A,B
	LD	(XDIR),A
	LD	A,(DRIVE)
	INC	A
	JR	Z,XP2	;DR-1
	LD	A,20H	;DR-2
XP2:	LD	B,A
	LD	A,(TRACK)    ;ADDR-HI
	ADD	A,B
	LD	DE,(TRACK+1) ;ADDR-MI AND LO
	LD	HL,XEBEC+1
	LD	(HL),A
	INC	HL
	LD	HL
	INC	(IX)
	LD	DE,(TRACK)
	LD	A,(TRACK+2)
	PUSH	AF		;LOWEST BYTE
	PUSH	DE		;L=HIGH, H=MIDL
HF6:	LD	(ERCOUN),HL
	LD	DE,L12
	CALL	TX3
	DEFB	46H		;£ OF BAD TRACKS
	LD	A,(IX)
	CALL	DECNUM
	JR	HF5
;
HF7:	LD	A,(IX)
	LD	(IX+1),A	;# OF BAD TRCKS
(HL),E
	INC	HL
	LD	(HL),D
	INC	HL
	LD	A,(RWLGT+1) ;BLOCK COUNT
	INC	A
	LD	(HL),A
	RET
;
;=============================================
;SEND A COMMAND TO HARD DISK		      ;
;SELECT CONTROLLER AND OUTPUT COMMAND TO XEBEC;
;RETURNS WITH NONZERO IF ERROR		      ;
;==============================================
XCOMD:	LD	A,1		;SELECT CODE
	OUT	(SASIDA),A
	LD	A,4		;SELECT
	OUT	(SASICO),A
	LD	B,0		;WAIT FOR BUSY
XC1:	CALL	SACON		;GET SASICO
	BIT	BUSY,A
	JR	NZ,XC15
	DJNZ	XC1
	OR	0FFH
	RET
DMEX
;
DDMRES:	LD	HL,(DMADR)
	RES	0,(HL)
;
;SEE IF ALL BYTES TRANSFERRED. IF NOT,
;RETURN WITH NONZERO AND READ USART3
;TO TRIGGER LOGIC STATE ANALYZER
	IN	A,(DMA+1)
	INC	A
	JR	Z,DDMR1
	IN	A,(DMA+1)
	JR	DDMR2
DDMR1:	IN	A,(DMA+1)
	AND	3FH
	CP;
XC15:	LD	BC,600H+SASIDA
	LD	HL,XEBEC	;COMMAND FIELD
XC2:	CALL	SACON	;GET SASICO
	RRA
	JR	NC,XC2
	OUTI
	JR	NZ,XC2
	LD	HL,(PAR)
	LD	BC,29H
	ADD	HL,BC	;GET CLOCK
	LD	C,(HL)	;STORE TIME
XC4:	CALL	SACON	;GET SASICO
	AND	1FH
	CP	1BH	;STATUS?
	JR	3FH
	JR	Z,DDMEX
DDMR2:	IN	A,(USART3)	;ERR TRIGGER	
DDMEX:	LD	A,0
	DI
	OUT	(DMA+8),A
	LD	A,(HL)		;ENABLE
	OUT	(DMA+8),A	;OTHER CHANNELS
	EI
	RET
;
;DECREMENT LOGICAL TRACK ADDRESS
DECTR:	LD	HL,TRACK+2
	LD	A,(HL)
	SUB	20H		;SEC/TRACK
	LD	(HL)	Z,XC5
	BIT	0,(IX+6)
	JR	NZ,XC4	;NO TIMOUT
	LD	A,(HL)
	SUB	C
	CP	180	;3 SEC TIMOUT
	JR	C,XC4
	JP	HF0	;ERROR	
;
XC5:	IN	A,(SASIDA)	;GET RESULT BYTE
	LD	E,A
XC6:	CALL	SACON	;GET SASICO
	RRA
	JR	NC,XC7
	IN	A,(SASIDA)
	LD	A,E
	AND	2
	RET	Z
	O,A
	JR	NC,DECT5
	DEC	HL
	LD	A,(HL)
	DEC	(HL)
	AND	A
	JR	NZ,DECT5
	DEC	HL
	LD	A,(HL)
	DEC	(HL)
	AND	A
	RET
DECT5:	OR	0FFH
	RET
;
XEBEC:	DEFB	0,0,0,0,0,0
R	0FFH
	RET
;
XC7:	BIT	0,(IX+6)
	JR	NZ,XC6	;NO TIMOUT
	LD	A,(HL)
	SUB	C
	CP	188	;TIMOUT?
	JR	C,XC6
	JP	HF0	;TIMEOUT, ABORT
;
;ACTUAL	READ-WRITE PROCEDURE
XRWPRO:	CALL	XPREP
	CALL	XRDY
	RET	NZ	;NOT READY
	CALL	DDMSET	;SET DISK DMA
	CALL	XCOMווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווD
	PUSH	AF
	CALL	DDMRES
	JR	Z,XRX
	POP	AF
XERR:	LD	A,3	;GET STATUS
	LD	HL,3	;4 BYTES
	LD	B,40H ;READ
	CALL	XPREP
	CALL	DDMSET
	CALL	XCOMD
	CALL	DDMRES
	LD	A,(DISBUF)
	AND	A
	RET
XRX:	POP	AF	;ERR CODE
	JR	NZ,XERR
	RET
;
SACON:	LD	A,90H
	ווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווOUT	(FDCWRO),A
	IN	A,(SASICO)
	RET
;
;==============================================
;CHECK READY BIT OF SASI CONTOLLER,	      ;
;EXIT: ZERO IF RDY			      ;	
;==============================================
XRDY:	LD	HL,(DSKFLG)
	LD	A,(HL)
	OR	SAS