TITLE IPL1.1  83-10-24
	SUBTTL INITIALIZATION AND IPL
	.Z80
	.PHASE 0
	INCLUDE AEQU.MAC
 GLOBAL PAR,DRIVE,TRACK,SECTOR,HEAD
 GLOBAL RWBUFF,RWLGT,READSEC,WRITSEC
 GLOBAL RESULT,CORRIG,PR1,PRCONT;
 EXTERNAL DINIT
;
;================================K
NOFLPY:	LD	A,0	;SEE FLOPPY-1
	LD	(DRIVE),A
	LD	A,INIFLG
	LD	(BOOTDR),A ;PREVENT ERR MSG 
ROMB1:	CALL	BOOTR
	JR	Z,ROMB2	;OK
	LD	HL,DRIVE
	DEC	(HL)	;SEE HARD DISK
	LD	A,(HL)
	CP	0FEH
	JR	NZ,ROMB15
	LD	A,1
	LD	(HL),A	;SEE FLOPPY-2
	LD	(BOOTDR)==============
;SET STACK POINTER,  INITIALIZE PORTS	      ;
;TRANSFER BIOS AND INTERRUPT ADDRESSES TO RAM ;
;==============================================
START:	DI		;FOR DEBUGGER G 0
	LD	SP,FRSTLD
	LD	HL,IOTAB
	LD	A,14	;13 OUTPUT BLOCKS
PORINI:	,A ;ENABLE ERR MESSAGE
ROMB15:	JR	NC,ROMB1
	JR	NOFLPY	;REPEAT FROM FLOPPY-1
;
;LOAD SUCCESSFUL
ROMB2:	LD	A,(DRIVE)
	LD	(BOOTDR),A
;
;RRECONFIGURE PRINT AND COMMUNICATION SPEED
	LD	A,45H
	LD	C,CTC1+2
	LD	HL,(FRSTLD+4)
	OUT	(C),A
	OUT	(C),L	;PR LD	B,(HL)	;NUMBER OF OUTPUTS
	INC	HL
	LD	C,(HL)	;PORT ADDRESS
	INC	HL
PORIN1:	OUTI
	JR	NZ,PORIN1
	DEC	A
	JR	NZ,PORINI
	IN	A,(SIOAD) ;REMOVE GARBAGE
	IN	A,(SIOBD)
	IN	A,(DMA+8) ;CLEAR STAT BITS
;HL POINTS TO ADDR OF CBIOS1 IN PROM
	LD	DE,CBIOS1SPEED
	DEC	C
	OUT	(C),A
	OUT	(C),H	;COMM SPEED
;
;UPDATE STEP RATE FROM DISK
	LD	HL,SPECBL+1 ;SPECIFY CMD
	CALL	OUT1
	LD	HL,FRSTLD+6 ;D0: 6MS, E0:4MS
	CALL	OUT1
	LD	HL,SPECBL+3
	CALL	OUT1
;
;INIT MEM DISK AND START LOADED PROGR
	JP	MEMDIN	
	
	LD	BC,BIOS2S-BIOS1S
	LDIR 		;TRANSFER CBIOS1
	LD	DE,CBIOS2
	LD	BC,BUFTAB-BIOS2S
	LDIR		;TRANSFER CBIOS2
	LD	DE,RAMBUF
	LD	C,INTTAB-BUFTAB
	LDIR		;TRANSFER BUFTAB
	LD	DE,INTVEC
	LD	C,20H
	LDIR		;TRANSFER INT VECTORS
	LD	A,D		;INT VEC HI
	LD	I,SUBTTL	ROM RESIDENT HARDWARE DRIVERS
	PAGE
;
;BOOT 1 OR 2 TRACKS FROM THE GIVEN DRIVE
;IF THE 3RD BYTE OF THE LOADED DISK IS:
;	80H	LOAD ONLY 1 TRACK (UCSD)
;	81H	LOAD 2 TRACKS FROM SINGLE SD
;	82H	LOAD 2 TRACKS FROM DOUBLE SD
;	OTHERWISE WRONG DISA
	IM	2
	EI		;INTERRUPT IS ENABLED
;
;MAKE INITIAL HANDSHAKE WITH TERMINAL
	CALL	CONIN
	LD	C,A
	CALL	CONOUT
	CALL	CONIN
	LD	C,A
	CALL	CONOUT
;
;============================================
;COMPARE CHECKSUM WITH THE STORED VALUE	    ;	
;=====K
BOOTR:	LD	HL,0
	LD	(TRACK),HL	;SET TRACK-0
	INC	HL		;SIDE=0, SECT=1
	LD	(TRACK+2),HL
	LD	HL,FRSTLD	;LOADING ADDR
	LD	(RWBUFF),HL
	LD	HL,0FFFH
	LD	(RWLGT),HL	;LOADED LGTH-1
	LD	BC,0846H
	CALL	RW0		;READ DATA
	JR	NZ,BOOTR3	;1ST TRACK BAD
	LD	A,=======================================
	LD	BC,10FEH	;BYTE COUNTER
	SUB	A
	LD	H,A
	LD	L,A		;BYTE POINTER
	LD	D,A		;D AND A ARE
CHS:	ADD	A,(HL)		;CHSUM COUNTER
	INC	HL
	JR	NC,$+3
	INC	D
	DEC	C
	JR	NZ,CHS
	DJNZ	CHS
	CP	(HL)		;CHSUM-LO
	INC	HL
(FRSTLD+3)	;IDENT BYTE
	SUB	80H		;UCSD?
	RET	Z
	CP	2
	JR	Z,BOOTR1
	JR	NC,BOOTR3	;WRONG IDENT
BOOTR1:	DEC	A
	LD	(HEAD),A	;1 IF DOUBLE
	JR	NZ,BOOTR2	;     SIDED
	INC	A
	LD	(TRACK),A	;SINGLE SIDED
BOOTR2:	LD	A,10H+(FRSTLD SHR 8) ;NEXT ADDR
	LD	(RW	LD	A,(HL)
	LD	HL,BADROM
	JR	CONTIN
	DEFB	0
	IF	$-66H
	BAD ADDRESS FOR NONMASKABLE INT!
	ENDIF
	LD	HL,(NONMI)
JPHL:	JP	(HL)		;NORMALLY DEBUG
CONTIN:	JR	NZ,BADCHS
	CP	D
	JR	Z,CHSOK
BADCHS:	CALL	TXOUT
	JR	$
CHSOK:	LD	HL,HELLO
	CALL	TXOUT
	IN	BUFF+1),A
	LD	BC,0846H
	CALL	RW0		;READ NEXT TR
	RET	Z		;OK
;
;DISK ERROR, SEE IF FIRST LOAD, THEN NO MESSAGE
BOOTR3:	LD	A,(BOOTDR)
	CP	INIFLG
	JP	Z,EXFF		;NONZERO & RET
SENERR:	LD	HL,DERMSG
	CALL	TXOUT
	CALL	CONIN
	SUB	1BH		;ESCAPE?
	RET	NZ
A,(FDSTAT)
	RLA
	JR	NC,NOFLPY	;IGNORE FLOPPY!
	LD	HL,DSKFLG
	RES	3,(HL)
;
	CALL	INTWAI	;FOR FLOPPY INTERR
	CALL	SENSIN	;RESTORE AFTERWARDS
	LD	HL,SPECBL
	CALL	OUT	;DO SPECIFY COMMD
	CALL	SENSIN	;RESTORE INTERRUPT
;
;BOOT FROM FLOPPY OR HARD DIS	JP	DINIT		;TO DEBUGGER
;
;
;==============================================
;READ AND WRITE ONE SECTOR		      ;
;ON ENTRY: SET 'DRIVE', 'TRACK' AND 'SECTOR'  ;
;	  AS WELL AS RWCOMD		      ;
;IN CASE OF ERROR 8 TIMES RETRY, IF NO SUCCESS;
;RECALIBRATE  SEEK,AND TRY AGAIN UP TO 8 TIMES;
;ON EXIT:  RESULT IS NONZERO IF ERROR	      ;
;==============================================
RW0:	LD	A,C
	LD	(RWCOMD+1),A	;FLOPPY COMMAND
	LD	A,(DRIVE)
	CP	4
	JR	C,RWFLO
;
;==================================
RWP0:	LD	HL,DSKFLG
	BIT	5,(HL)
	JR	Z,RWP0	;WAIT 0.3 SEC IF NOT UP
	SET	1,(HL)	;RDWR FLAG
	CALL	DDMSET	;SET DISK DMA
	LD	HL,RWCOMD
	CALL	OUT	;SEND COMMAND BYTES
	CALL	INTWAI	;WAIT FOR INTERRUPT
	LD	HL,15*60 ;15 SEC FOR MOTOR OFF
	LD	(TBYTE),HL
	============
;ADDRESS XEBEC CONTROLLER		      ;	
;==============================================
	LD	HL,XEBEC ;SHARES 'RESULT' FIELD
	LD	(HL),B	;FUNCTION
	INC	HL
	EX	DE,HL
;
;COMPUTE TRACK*10H+SECTOR
	LD	HL,(TRACK)
	LD	BC,(SECTOR)
	DEC	C
	SUB	ALD	HL,DSKFLG
	BIT	4,(HL)	;NOT READY?
	JR	NZ,RWP2	;
	LD	B,7
	CALL	INP	;GET RESULT BYTES
	CALL	DDMRES	;RESET DISK DMA
	RET	NZ
	LD	A,(RESULT)
	AND	0C0H	;ZERO IF OK
	RET
;
RWP2:	LD	A,MOTON
	OUT	(FDCWRO),A	;RESET FDC
	LD	A,MOTON+NOTRES
	OUT	(FDCWR	;FOR OVERFLOW
	LD	B,4
	ADD	HL,HL
	RLA		;GET CARRY
	DJNZ	$-2
	ADD	HL,BC	;B=0, C=SECTOR-1
	ADC	A,B
	LD	B,A	;SAVE ADDR-HI
	LD	A,(DRIVE) ;=FF FOR DRIVE-0,
	INC	A	;ELSE DRIVE-1
	JR	Z,$+4
	LD	A,20H	;ADDRESS DRIVE-1
	ADD	A,B	;COMBINE WITH HI BYTE
	EO),A	;LET MOTOR RUN
	LD	HL,DSKFLG
RWP3:	BIT	2,(HL)	;RESET?
	JR	NZ,RWP3	;WAIT UNTIL INTERRUPT
	PUSH	HL
	LD	HL,-1
	LD	(TRACK0),HL ;DEL TRACK NUMBERS
	LD	(TRACK0+2),HL
	CALL	SENSIN	;NEEDED AFTER RESET!
	CALL	DDMRES
	POP	HL
	OR	(HL)	;SET NONZERO
	RX	DE,HL
	LD	(HL),A
	INC	HL
	LD	(HL),D	;ADDR MIDDLE BYTE
	INC	HL
	LD	(HL),E	;ADDR LO
	INC	HL
	LD	A,(RWLGT+1)
	INC	A
	LD	(HL),A	;BLOCK COUNT
	INC	HL
	SUB	A
	LD	(HL),A	;CONTROL BYTE
	LD	B,2	;DO TWICE (TOGETHER 8)
XRW:	PUSH	BC
	CALL	XRWPRO
	POPET
;
;SET	DISK,DMA
DDMSET:	DI
	LD	A,(RWBUFF)
	OUT	(DMA),A	;ADDRESS
	LD	A,(RWBUFF+1)
	OUT	(DMA),A
	LD	HL,(RWLGT)
	LD	A,L	;LO LENGTH-1
	OUT	(DMA+1),A
	LD	A,(RWCOMD+1)
	CPL
	RRCA
	RRCA
	AND	0C0H	;SET DIRECTION
	OR	H	;HI LENGTH-1
	OUT	(DMA+1),	BC
	RET	Z
	DJNZ	XRW
	RET
;
;FLOPPY READ-WRITE SUBROUTINE
RWFLO:	LD	A,(DSKFLG)
	AND	NOFLOP
	JR	NZ,FFRET ;NO FLOPPY CONTROLLER!
	CALL	MOTON?	;SW MOTOR ON IF NEEDED
	CALL	SEEK	;STEP IF NECESSARY
	LD	A,(HEAD)
	LD	(RWCOMD+4),A	;HEAD
	RLCA
	RLCA
A
	LD	HL,DMSTAT
	SET	0,(HL)	;CHANNEL 0 ENABLED
	JR	DDMEX
;
DDMRES:	LD	HL,DMSTAT
	RES	0,(HL)
;
;SEE IF ALL BYTES TRANSFERRED. IF NOT,
;RETURN WITH NONZERO AND READ USART3
;TO TRIGGER LOGIC STATE ANALYZER
	IN	A,(DMA+1)
	INC	A
	JR	Z,DDMR1
	IN	A,	LD	HL,(DRIVE) ;DRIVE AND TRACK
	OR	L
	LD	L,A	;COMBINE HEAD INFO
	CALL	DSKTR	;TRACK INCR
	LD	(RWCOMD+2),HL
	LD	A,(SECTOR)
	LD	(RWCOMD+5),A ;ACTUAL SECTOR
	LD	C,2	;RESEEK ONCE ON ERROR
RWS1:	LD	B,8	;READ/WRITE 8 TIMES
RWS2:	PUSH	BC
	CALL	RWPROC
	(DMA+1)
	JR	DDMR2
DDMR1:	IN	A,(DMA+1)
	AND	3FH
	CP	3FH
	JR	Z,DDMEX
DDMR2:	IN	A,(USART3)	;ERR TRIGGER	
DDMEX:	LD	A,0
	DI
	OUT	(DMA+8),A
	LD	A,(HL)		;ENABLE
	OUT	(DMA+8),A	;OTHER CHANNELS
	EI
	RET
;
;===========================================POP	BC
	RET	Z
	LD	A,(DSKFLG)
	BIT	4,A	;NONZERO IF NOT RDY
	JR	NZ,FFRET ;NO REPEAT
	LD	A,(RESULT+1)
	BIT	1,A	;WRITE PROTECT?
	JR	NZ,FFRET ;NO RETRY
	DJNZ	RWS2
RWS3:	DEC	C
	JR	Z,FFRET
	PUSH	BC
	LD	A,(TRACK)
	PUSH	AF
	ADD	A,10
	LD	(TRACK),A
	C===
;SEEK THE TRACK GIVEN IN 'TRACK'	      ;
;==============================================
SEEK:	LD	A,(DRIVE)
	LD	HL,TRACK0-1
	INC	A
SEEK0:	INC	HL
	DEC	A
	JR	NZ,SEEK0
SEEK1:	LD	A,(TRACK)
	LD	B,A
	CP	(HL)	;SAME TRACK?
	RET	Z	;DO NOTHING
	LD	AP	20
	CALL	C,SEEK	;STEP OUT 10 IF TRACK<10
	LD	HL,DSKFLG
	SET	2,(HL)	;SIMULATE NOTREADY
	CALL	RWP2	;RESET CONTROLLER
	POP	AF
	LD	(TRACK),A ;RESTORE TRACK NUMBER
	CALL	SEEK	;STEP AGAIN
	POP	BC
	JR	RWS1
FFRET:	OR	0FFH	;SET NONZERO
	RET
;
RWPROC:,(HL)
	INC	A	;ZERO IF UNDEFINED
	LD	A,B
	LD	(HL),A	;UPDATE TRACK NUMBER
	CALL	Z,RECALI
	LD	HL,SKCOMD
	JR	RECAL1
;
;RECALIBRATE DRIVE
RECALI:	LD	A,(DRIVE)
	LD	(RECOMD+2),A ;SET DRIVE
	LD	HL,RECOMD
	CALL	RECAL1	     ;DO OPERATION
	LD	A,(RESULT)
	AND	0C0H
	RET	Z	     ;OK
	LD	HL,RECOMD    ;REPEAT
RECAL1:	CALL	OUT
	CALL	INTWAI	;WAIT FOR INTERRUPT
;
SENSIN:	LD	DE,0F080H ;UNTIL RDY FOR OUTP
	CALL	WAIT
	LD	A,8	;SENSE INTERRUPT
	OUT	(FDDAT),A
	LD	B,2
	CALL	INP
	RET
;
;====================	;UNTIL FDC READY
	IN	A,(FDDAT)
	LD	(HL),A
	INC	HL
	DJNZ	INP1
	RET
;
;==============================================
;READ OR WRITE TO HARD DISK		      ;
;SELECT CONTROLLER AND OUTPUT COMMAND TO XEBEC;
;RETURNS WIT NONZERO IF ERROR		      ;
;=============================
;SWITCH	MOTOR ON IF IT DOES NOT RUN	      ;
; (NO WAITING LOOP!)			      ;
;ON EXIT:	NONZERO IF RUNS		      ;
;==============================================
MOTON?:	DI
	LD	HL,30	;0.5 S START RUN-UP
	LD	(TBYTE),HL
	LD	HL,===========================================
XCOMD:	LD	A,1		;SELECT CODE
	OUT	(SASIDA),A
	LD	A,4		;SELECT
	OUT	(SASICO),A
	LD	B,0		;WAIT FOR BUSY
XC1:	IN	A,(SASICO)
	BIT	BUSY,A
	JR	NZ,XC15
	DJNZ	XC1
	JR	XC44	;ERROR
XC15:	LD	BC,600H+SASIDA
	LD	HLDSKFLG
	RES	7,(HL)	;NO SASI
	LD	A,(DRIVE)
	CP	3	;IF DRIVE-3, ENABLE BIT
	LD	A,MOTON+NOTRES
	JR	NZ,MOT1
	OR	DS4EN
MOT1:	OUT	(FDCWRO),A
	LD	A,(HL)
	AND	MOTON+MOTSWO	;ALREADY ON?
	JR	NZ,MOT2
	SET	6,(HL)	;STARTUP FLAG
	SUB	A	;SAY NOT RUNS
MOT2:	EI,XEBEC	;COMMAND FIELD
XC2:	IN	A,(SASICO)
	RRA
	JR	NC,XC2
	OUTI
	JR	NZ,XC2
	LD	HL,CLOCK
	LD	C,(HL)	;STORE TIME
XC4:	IN	A,(SASICO)
	AND	1FH
	CP	1BH		;STATUS?
	JR	Z,XC5	;OK
	LD	A,(HL)
	SUB	C
	CP	180	;3 SEC TIMOUT?
	JR	C,XC4	;NO TIMOUT
XC44:	LD
	RET
;
;==============================================
;SEND COMMAND TO DISK CONTROLLER	      ;
;ENTRY:	HL POINTS TO PARAMETER BLOCK	      ;
;	PARAMETER BLOCK: LENGTH, DATA, DATA, .;
;==============================================
OUT:	PUSH	HL
	C	HL,(HDERSU)	;=RETURN
	CALL	JPHL	;FOR MAINTENANCE
	LD	A,8
	OUT	(SASICO),A	;RESET SASI
	DI
	LD	A,(DSKFLG)
	AND	MOTON+MOTSWO
	LD	A,NOTRES
	JR	Z,$+4
	OR	MOTON
	OUT	(FDCWRO),A
	OR	SASINT
	OUT	(FDCWRO),A	;CLEAR A FLOP
	EI
	OR	0FFH
	RET
;
XC5:	IALL	MOTON?	;SW MOTOR ON IF NOT RUN
	POP	HL
	LD	B,(HL)	;GET LENGTH
OUT0:	EI
	INC	HL
OUT2:	LD	DE,0E080H ;MASK=F0 COMPARE=80
	CALL	WAIT	;WAIT UNTIL READY
	LD	A,(HL)	;GET DATA
	DI		;PREVENT EARLY INTERRUPTS
	OUT	(FDDAT),A ;TO FLOPPY CONTROLLER
	DJNZ	N	A,(SASIDA)	;GET RESULT BYTE
	LD	E,A
XC6:	IN	A,(SASICO)
	RRA
	JR	NC,XC7
	IN	A,(SASIDA)
	LD	A,E
	AND	2
	RET	Z
	JR	XC44	;RESET AND ERR RET
XC7:	LD	A,(HL)
	SUB	C
	CP	188	;TIMOUT?
	JR	C,XC6
	JR	XC44	;TIMEOUT, ABORT
;
;ACTUAL	READ-WRITE PROCEDUOUT0
	LD	HL,DSKFLG
	RES	0,(HL)	;RESET OP-READY FLAG
	RES	4,(HL)	;DISK NOT-RDY FLAG
	BIT	1,(HL)	;READ/WRITE?
	EI
	RET	Z	;NO TIMOUT NECESSARY
	LD	HL,37	   ;617 MS FOR
	LD	(TBYTE),HL ;DISK NOT READY
	RET
OUT1:	LD	B,1	;OUT 1 BYTE
	JR	OUT2
;
WAITINRE
XRWPRO:	CALL	XRDY
	RET	NZ	;NOT READY
	CALL	DDMSET	;SET DISK DMA
	CALL	XCOMD
	PUSH	AF
	CALL	DDMRES
	JR	Z,XRX
	POP	AF
	OR	0FFH
	RET
XRX:	POP	AF	;ERR CODE
	RET
;
;==============================================
;CHECK READY BIT OF SASI CONTOLP: LD	DE,0E0C0H ;UNTIL READY FOR INP
;
;WAIT UNTIL FLOPPY CONTROLLER RDY FOR IN OR OUT
;ON ENTRY: D=MASK E=COMPARE BYTE FOR STATUS REG
WAIT:	IN	A,(FDSTAT)
	AND	D
	CP	E
	JR	NZ,WAIT
	RET
;
INTWAI:	LD	HL,DSKFLG	;DONE?
INTW1:	BIT	0,(HL)
	JR	Z,INTW1LER,	      ;
;EXIT: ZERO IF RDY			      ;	
;==============================================
XRDY:	LD	A,(DSKFLG)
	OR	SASINT
	LD	(DSKFLG),A
	AND	MOTON+MOTSWO
	LD	A,NOTRES+SASINT
	JR	Z,$+4
	OR	MOTON
	OUT	(FDCWRO),A
	IN	A,(SASICO)
	BIT	BUSY,A
	RET	
	RET
;
;==============================================
;GET RESULT BYTES. ON ENTRY B=NUMBER OF BYTES ;
;==============================================
INP:	LD	A,MOTON+NOTRES
	OUT	(FDCWRO),A ;DISABLE 4TH DRIVE
INP0:	LD	HL,RESULT
INP1:	CALL	WAITINPZ
	LD	A,8
	OUT	(SASICO),A	;RESET
	RET
;
;==============================================
;GET ONE CHARACTER FROM KEYBOARD              ;
;==============================================
CONIN:	EI
	CALL	CONST
	DI
	LD	A,20H	;ENABLE NEXT INTERR
	OUT	(SIOBC),A
	JR	Z,CONIN	;WAIT UNTIL READY
	SUB	A
	LD	(KSTAT),A
	IN	A,(SIOBC)
	BIT	0,A	;FURTHER CHAR?
	JR	NZ,CONP1 ;YES, RTS REMAINS
	LD	A,5
	OUT	(SIOBC),A
	LD	A,0EAH
	OUT	(SIOBC),A	;ENABLE RTS
CONP1:	LD	A,(KBYTE)
	EI
	RET
;
;=================NT IF CORR. TABLE
	JR	PRT6	;SEE IF ANY NEXT ELEMENT
;
PRT8:	LD	A,B
PRT9:	INC	HL
	DEC	D
	DEC	A
	JR	NZ,PRT9	;IGNORE STRANGE ELEMENT
	JR	PRT5
;
;
;==============================================
;PRINT ONE CHARACTER FROM REGISTER 'C'	      ;
;IF C=============================
;SEND ONE CHARACTER TO COMMUNICATION FROM 'C'
;==============================================
COMOUT: IN	A,(SIOAC)
	BIT	2,A
	JR	Z,COMOUT
	LD	A,C
	OUT	(SIOAD),A
	RET
;
;==============================================
TS=1, PRINT CHARACTER, SET PRSTAT TO FF  ;
;	   AND EXIT			      ;	
;ELSE IF PRSTAT=0 EXIT (PRINTER ERROR)	      ;
;	   ELSE WAIT UP TO 15 SECONDS FOR CTS ;
;ON EXIT ZERO FLAG SET IF NOT PRINTED !!!!!   ;
;=============================================;GET ONE CHARACTER FROM COMMUNICATION TO 'A'
;==============================================
COMIN:	IN	A,(SIOAC)
	BIT	0,A
	JR	Z,COMIN
	IN	A,(SIOAD)
	RET
;
;==============================================
;PRINT ONE CHARACTER FROM PRINT TABLE
;ON E=
PR1:	CALL	LI4
	RET	NZ		;OK
	LD	A,(PRSTAT)
	AND	A
	RET	Z	;PREVIOUSLY,ALSO BAD
	LD	A,(PRWAIT)
	LD	B,A	;DEFAULT: 4*4=16 SEC
	LD	HL,CLOCK+1
	ADD	A,(HL)
	LD	B,A
PRI1:	CALL	LI4	;READY?
	RET	NZ	;OK,PRINTED
	LD	A,B
	SUB	(HL)
	JR	NZ,PRI1
	LD	A,(PRNTRY: IN PRTAB IS THE PRINT TABLE ADDRESS
;	   IF IT IS ZERO, SIMPLE PRINT
;FOR PRINT TABLE STRUCTURE SEE SYS REF MANUAL!!
;==============================================
LSTTAB:	LD	HL,(PRTAB)
	LD	A,H
	OR	L
	JR	Z,PR1
	LD	A,1
	LD	(RESULT+1),A ;Ј OFCONT)
	AND	A
	JR	Z,PRI2	;NO MESSAGE
;
PRI15:	PUSH	BC
	LD	HL,PRIGN ;IGNORE PRINTER?
	CALL	TXOUT
	CALL	CONIN
	POP	BC
	SUВ	ESC	;ESCAPE?
	JR	Z,PRI2
	CALL	LI4
	RET	NZ	;OK
	JR	PRI15	;CHECK AGAIN
;
PRI2:	LD	(PRSTAT),A ;IGNORE PRINTER
	RET
;
;=== REPL CHARS
PRT1:	CALL	LDAHL	;Ј OF LEVELS
	LD	E,A
	INC	HL
	INC	E
	LD	A,(RESULT+1)
	DEC	A
	LD	B,A	;INIT # OF RPL CHARS-1
	JR	Z,PRT2	;IGNORE AT TRANSP TABLE
	CALL	LDAHL	;BACKSPACE CHAR
	INC	HL
	LD	(RESULT),A
PRT2:	INC	B
	LD	A,B
	CP	E
	JR	C,PRT===========================================
;PRINT ONE CHARACTER FROM 'C'
;ON EXIT: A=0 AND ZERO FLAG SET IF NOT RDY
;	  A=FF AND ZERO FLAG RESET ID PRINTED
;==============================================
LI4:	CALL	LISTAT
	RET	Z
LI5:	LD	A,C
	OUT	(U4	;NEXT LEVEL
	LD	A,(RESULT+1)
	INC	A
	LD	(RESULT+1),A ;=3 IF END OF
	CP	3	     ;CORR TABLE
	JR	NZ,PRT1	;SEE CORRECTING TABLE
;
;IF CHARACTER IS OVER 0A0H AN NOT IN THE TABLE
;REPLACE IT WITH SPACE
	LD	A,C
	CP	0A0H
	JR	C,PRTC
	LD	C,20H
;
;NOTSART3),A
EXFF:	OR	0FFH
	LD	(PRSTAT),A
	RET
;
;=============================================
;LIST ONE OR MORE SCREEN LINES
;ON ENTRY: BC = SCREEN ADDRESS
;	   A  = NUMBER OF LINES
;ON EXIT:  A  = ZERO IF BAD
;=====================================HING FOUND IN TABLE, PRINT ORIG CHAR
PRTC:	PUSH	HL
	PUSH	BC
	CALL	PR1	;PRINT 1 CHARACTER
	POP	BC
	POP	HL
	RET
;
PRT4:	CALL	LDAHL	;LENGTH OF LEVEL
	LD	D,A
	INC	HL
PRT5:	LD	A,D
	AND	A	;ZERO?
	JR	Z,PRT2	;GET NEXT ONE
	CALL	LDAHL
	DEC	D
	INC	HL========
PRISCR:	AND	A
	RET	Z
	PUSH	AF	;NUMBER OF LINES
	POP	HL
	LD	A,(PRCONT)
	PUSH	AF
	SUB	A
	LD	(PRCONT),A ;NO MESSAGE
	PUSH	HL
	PUSH	BC	;START ADDR
;
;REMOVE ALL CHARACTERS FROM THE QUEUE
PRS1:	LD	HL,CLOCK
	LD	A,(HL)
	ADD	A,2
	CP	(HL)

	CP	C
	JR	NZ,PRT8
PRT6:	CALL	LDAHL
	LD	C,A
	INC	HL
	CALL	PRTC	;PRINT 1ST ELEMENT
	DJNZ	PRT7	;SEE IF MORE ELEMENTS
	AND	A	;SET RET CODE
	RET
;
PRT7:	LD	A,(RESULT+1) ;CORRECTING TABLE?
	CP	2
	LD	A,(RESULT) ;BACKSPACE
	LD	C,A
	CALL	Z,PRTC	;PRI	JR	NZ,$-1	;WAIT UNTIL NO KEY
	CALL	CONST
	JR	Z,PRS15	;NO KEY
	CALL	CONIN
	JR	PRS1
;
;LOCK THE KEYBOARD AND GET TERMINAL STATUS
PRS15:	LD	C,19H
	CALL	CONOUT
	LD	C,'?'
	CALL	ESCAPE
	CALL	CONIN	;COLUMN
	LD	L,A
	CALL	CONIN
	LD	H,A	;ROW
	LD	B,10
PRS2:	CALL	CONIN	;REMOVE 10 BYTES
	DJNZ	PRS2
;
;POSITION CURSOR TO THE FIRST CHARACTER
	EX	(SP),HL	;GET START ADDR
	LD	A,1FH
	LD	BC,-50H
PRS3:	INC	A
	ADD	HL,BC
	JR	C,PRS3
	LD	C,A	;ROW
	LD	A,L
	ADD	A,70H
	LD	H,A
	LD	L,C	;COLUMN
	CALL	SCRPOSTER BLOCK FOR SPECIFY COMMAND	      ;
;==============================================
SPECBL:	DEFB 3		;LENGTH
	DEFB 3		;COMMAND CODE
	DEFB 0D0H	;SRT=6MS HUT=480MS
	DEFB 0AH	;HLT=5MS
;
;==============================================
;INITIALIZING TA
;
	LD	C,'$'
	CALL	ESCAPE	;CHAR INPUT MODE
	POP	HL
	POP	BC
	PUSH	BC	;B=NUMB OF LINES
	PUSH	HL
;
;CALCULATE LENGTH
	LD	HL,0
	LD	DE,50H
PRS4:	ADD	HL,DE
	DJNZ	PRS4
	LD	C,L
	CALL	CONOUT
	LD	C,H
	CALL	CONOUT
	POP	HL	;OLD SCREEN POS
	LD	BC,202BLE FOR CTC, USART AND FDC    ;
;STRUCTURE:	LENGTH,PORT_ADDRESS,OUTPUT_DATA
;==============================================
IOTAB:
	DEFB 1		;1 BYTE
	DEFB SASICO	;TO SASI CONTROLLER
	DEFB 8		;RESET
;
	DEFB 1
	DEFB DMA+8	;RESET DMA
	DEFB 0
;
	DEF0H
	ADD	HL,BC
	CALL	SCRPOS
	LD	C,CR
	CALL	LSTTAB	;SW TO ONLINE IF POSSIB
;
;PRINT EACH LINE WITH CRLF
	POP	BC
PRS5:	PUSH	BC
	LD	C,CR
	CALL	LSTRDY
	LD	C,LF
	CALL	LSTRDY
	LD	E,50H
PRS6:	PUSH	DE
	CALL	CONIN
	LD	C,A
;
;REPL WITH SPACE IF CONTB 1
	DEFB SIOBC	;RESET TERMINAL CHANNEL
	DEFB 0D8H
;
	DEFB 3		;SEND 3 BYTES
	DEFB CTC1	;PORT ADDRESS
	DEFB INTVEC AND 0FFH ;INTERRUPT VECTOR
	DEFB 45H	;COUNTER,LOAD TIMECONST
	DEFB 1H		;19200 BD FOR CONSOLE
;
	DEFB 13
	DEFB SIOBC	;SIO CHANNEL-B ROL
	RES	7,A
	CP	20H
	JR	C,PRS8
	CP	DEL
	JR	NZ,PRS9
PRS8:	LD	C,20H
PRS9:
	CALL	LSTRDY
	POP	DE
	DEC	E
	JR	NZ,PRS6
	POP	BC
	DJNZ	PRS5
;
	LD	C,2
	CALL	CONOUT	;UNLOCK KEYBOARD
	POP	AF
	LD	(PRCONT),A
	LD	C,CR
	CALL	LSTRDY
	LD	C,LF
	CALL	LSCONTROL
	DEFB 0D8H	;RESET TERM CHAN AGAIN
	DEFB 0
	DEFB 2
	DEFB (INTVEC+16) AND 0FFH
	DEFB 4
	DEFB 48H
	DEFB 3
	DEFB 0E1H
	DEFB 5
	DEFB 0EAH
 	DEFB 1
	DEFB 0CCH
	DEFB 20H	;ENABLE REC INTERR
;
	DEFB 2		;SEND 2 BYTES
	DEFB CTC1+1
	DEFB 45H
TRDY
	LD	A,(PRSTAT)
	AND	A
	PUSH	AF
	LD	C,BELL
	CALL	Z,CONOUT
	POP	AF
	RET
;
;PRINT ONLY IF OK
LSTRDY:	LD	A,(PRSTAT)
	AND	A
	CALL	NZ,LSTTAB
	RET
;
ESCAPE:	PUSH	BC
	LD	C,ESC
	CALL	CONOUT
	POP	BC
	JP	CONOUT
;
;POSITION THE SCREEN H=ROW L	DEFB 2		;9600 BD FOR COMMUNIC
;
	DEFB 2		;SEND 2 BYTES
	DEFB CTC1+2
	DEFB 45H
	DEFB 10H	;1200 BD FOR PRINTER
;			DEVIDE IN USART
;
	DEFB 2		;SEND 2 BYTES
	DEFB CTC1+3
	DEFB 0D5H	;DMA INT POSITIVE EDGE
	DEFB 1		;INT ON FIRST COUNT
;
	DEFB 3		;=COLUMN
SCRPOS:	LD	C,'Y'
	CALL	ESCAPE
	LD	C,H	;ROW
	CALL	CONOUT
	LD	C,L	;COLUMN
	JP	CONOUT
;
;==============================================
;DISPLAY A LINE TO TERMINAL, ADD CRLF	      ;
;ON ENTRY HL POINTS TO THE TEXT		      ;
;ON EXIT ALL REGISEND 3 BYTES
	DEFB CTC2
	DEFB (INTVEC+8) AND 0FFH
	DEFB 0D5H
	DEFB 28H	;60HZ FOR TIMER
;
	DEFB 2		;SEND 2 BYTES
	DEFB CTC2+1
	DEFB 45H
	DEFB 0		;OUT: 2400 HZ
;
	DEFB 2		;SEND 2 BYTES
	DEFB CTC2+3
	DEFB 0C5H	;FDC INT NEGATIVE EDGE
	DEFB 1		;INSTERS ARE SAVED EXCEPT HL    ;
;==============================================
TXOUT:	LD	B,(HL)
TXO1:	INC	HL
	LD	C,(HL)
	CALL	CONOUT
	DJNZ	TXO1
	RET
;
PRIGN:	DEFB	DERMSG-PRIGN-1
	DEFB	0DH,0AH,07H,'IGNORE PRINTER WITH ESC'
DERMSG:	DEFB	BADROM-DERT ON FIRST COUNT
;
	DEFB 2		;SEND 2 BYTES
	DEFB FDCWRO
	DEFB 0
	DEFB 0+NOTRES
;
	DEFB 9		;PROGRAM SIO
	DEFB SIOAC	;SIO CHANNEL A CONTROL
	DEFB 0D8H	;RESET COMMUN CHANNEL
	DEFB 1		;ADDR WR REG-1
	DEFB 0		;COMM IN POLLED MODE
	DEFB 3		;
	DEFB 0EMSG-1
	DEFB	0DH,0AH,'SYSTEM DISK?'
BADROM:	DEFB	HELLO-BADROM-1
	DEFB	0DH,0AH,'BAD ROM'
HELLO:	DEFB	MSGEND-HELLO-1,0DH,0AH,'IPL-1.1',0DH,0AH
MSGEND:
	SUBTTL PORT INITIALIZATION TABLES
	PAGE
;
;==============================================
;PARAME1H	;8 BIT/CHAR
	DEFB 4
	DEFB 88H	;DIV BY 32, 1,5-STOPBIT
	DEFB 5
	DEFB 068H	;DISABLE TRANSMITTER
;
	DEFB 6		;SEND 6 BYTES
	DEFB USART3+1
	DEFW 0
	DEFW 4000H
	DEFB 0CEH	;PRINTER 1200BD, ASYNCHR
	DEFB 27H	;ENABLE IN, OUT, DTR
;
	.DEPHASE
BIOS1S:
	SUBTTL INTERFACING JUMP TABLE AND INITIALIZATION IN RAM
	PAGE
	.PHASE	0F606H
CBIOS1:
;INTERFACE FOR CONFIGURATION PROGRAM !!!!
;IF 63K CP/M IS USED, THESE ADDRESSES ARE VALID
;
	JP	CONST	;CONSOLE STATUS
	JP	CONIJP	;CONSOLE CHARACTER IN
	JP	CONYTES CODED, SECT
	DEFW	0E10H	;GAP LGT, # OF SECTORS
	DEFB	0	;DATA LGTH CODED
;
RECOMD:	DEFB	2	;LGTH OF RECALIBR COMMD
	DEFW	0007H	;DRIVE-0, RECALIBRATE
;
TDMLGT:	DEFB	0	;TTOUT DMA LGTH
TBUCOU:	DEFB	0	;TTOUT BUFFER COUNTER
;
NONMI:	DEFW	DINIT
;
OUT	;CONSOLE CHARACTER OUT
	JP	LIST1	;PRINT CHAR FROM TABLE
	JP	COMOJP	;COMM OUTPUT
	JP	COMIJP	;COMM INPUT
;
;==============================================
;SWITCH TO RAM
;	IF NO SPACE KEY DEPRESSED THEN
;		IF EXTENSION RAM PRESENT THEN
;		FILL TSKCOMD:	DEFB	3	;LGTH OF SEEK COMMAND
	DEFB	0FH	;SEEK
;
;==============================================
;THIS IS THE PARAMETER BLOCK POINTED TO AT FFD0	   
;==============================================
DRIVE:	DEFB	0	 ;00  ACTUAL DRIVE NUMBER
TRACK:HE FIRST PAGE WITH E5
;		END
;		CLEAR SYSTEM CLOCK
;	END
;JUMP TO THE LOADED PROGRAM
;==============================================
MEMDIN:	LD	HL,CLOCK
	LD	A,(HL)
	ADD	A,2	;WAIT CHAR DELAY
MEMDI3:	CP	(HL)
	JR	NZ,MEMDI3
	LD	A,(KBYTE)
	CP	20H	;S	DEFW	0	 ;01  ACTUAL TRACK NUMBER
SECTOR:	DEFB	1	 ;03  ACTUAL SECTOR NUMBER
HEAD:	DEFB	0	 ;04  ACTUAL HEAD NUMBER
RWBUFF:	DEFW	0D600H	 ;05  READ-WRITE BUFFER ADDR
RWLGT:	DEFW	0FFFH	 ;07  READ-WRITE LENGTH-1
RDS:	DEFW	READSEC	 ;09  READ SECT SUBR
WRS:PACE?
	JR	Z,MEMD1 ;DO NOT CLEAR RAM DISK
	LD	A,0F8H
	OUT	(MEXTP),A ;SWITCH TO EXT RAM
	LD	HL,0
	LD	E,(HL)	;IF EXT APPL, IT IS RAM
	LD	A,E
	CPL
	LD	(HL),A	;INVERT IT
	LD	A,(HL)
	XOR	E
	LD	(HL),E	;RESTORE
	INC 	A	;=0 IF OK
	JR	NZ,MEMD0 ;NO EXTEN	DEFW	WRITSEC	 ;0B  WRITE SECT SUBR
STEP:	DEFW	SEEK-0	 ;0D  SEEK ROUTINE ADDR IN PROM !!!!!!
RECAL:	DEFW	RECALI-0 ;0F ECALIBR SUBR ADDR IN PROM !!!
	DEFW	BOOTER	 ;11  BOOTSTAP SUBR
	DEFW	LISTAT	 ;13  LIST STATUS
PRTAB:	DEFW	0	 ;15  PRINT TABLE ADDR
PSION
	LD	H,40H	
	LD	DE,4001H
	LD	BC,3FFFH
	LD	(HL),0E5H
	LDIR		;CLEAR IT
;
;CLEAR SYSTEM CLOCK
MEMD0:	LD	HL,0
	LD	(CLOCK),HL
	LD	(CLOCK+2),HL
;
MEMD1:	LD	A,2
	DI
	OUT	(MEMMGR),A ;SW IN RAM
	LD	(MSWBYT),A
	EI
	SUB	A
	OUT	(MEXTP),A ;SW OUT RWAIT:	DEFB	4	 ;17  PRINT LOOP FOR 16 SECONDS
PRSTAT:	DEFB	0FFH	 ;18  PRINTER ASSUMED RDY
PRCONT:	DEFB	0	 ;19  NO MESSAGE IF NOT RDY
BOOTDR:	DEFB	INIFLG	 ;1A  BOOTING DRIVE (FF,0 OR 1)
DSKFLG:	DEFB	NOFLOP	 ;1B  INTERNAL DISK FLAG
COMPL	EQU BIT0 ;OPR CEXT
	JP	FRSTLD
;
	.DEPHASE
BIOS2S:
	.PHASE 0FD40H
CBIOS2:
	SUBTTМ BIOS
	PAGE
	INCLUDE	BIOS.MAC
	.DEPHASE
	SUBTTL INTERNAL VARIABLES AND DRIVER PARAMETER BLOCK
	PAGE
BUFTAB:
;==============================================
;VARIABLE INIT VALUEOMPLETED
RDWR	EQU BIT1 ;READ OR WR OP
RESET	EQU BIT2 ;CONTROLLER RESETTED
NOFLOP	EQU BIT3 ;=1 IF NO FLOPPY CONTR
NOTRDY	EQU BIT4 ;DISK NOT RDY
;MOTON	EQU BIT5 ;MOTOR ON (PREV DEF)
MOTSWO	EQU BIT6 ;MOTOR IN TRANSIENT
SASINT	EQU BIT7 ;SASI INTERFACE
S TO BE TRANSFERRED TO RAM
;==============================================
;
	.PHASE 0FF80H
RAMBUF:
DSKSP	EQU	RAMBUF-6CH
HLSAVE	EQU	DSKSP+16H
DMSTAK	EQU	HLSAVE+2
SPSAVE	EQU	DMSTAK+10H
TTOBUF	EQU	SPSAVE+2
TBULGT	EQU	40H	;LENGTH OF TTYOUT BUFF
TBY;
DMSTAT:	DEFB	40H	 ;1C  INTERNAL DMA SHADOW BYTE
HDERSU:	DEFW	RETURN	 ;1D  XEBEC ERROR ROUTINE
DSKTR:	DEFW	0C900H	 ;1F  TRACK NUMBER UNCHANGED
PRS:	DEFW	PRSCR	 ;21  ADDR OF PRINT SCREEN
MSWBYT:	DEFB	0	 ;23  0 IF ROM, 2 IF RAM PROGR RUNS
	DEFB	0C3H	 TE	EQU	TTOBUF+TBULGT
;
;MISCELLENOUS VARIABLES TO INITIALIZE
TRACK0:	DEFW	-1	;TRACKPOINTERS = -1
	DEFW	-1	;= 0FF IF UNDEFINED
;
RWCOMD:	DEFB	09H	;FLOPPY READ-WRITE OP
	DEFW	0046H	;DRIVE-0 ,READ SECT
	DEFW	0001H	;HEAD, (TRACK #)
	DEFW	0101H	;# OF B;24  JUMP TO EXT TIMER INT
TINEX:	DEFW	RETURN	 ;26  ADDRESS OF EXTERNAL TIMER INT
KSTAT:	DEFB	0	 ;27  KEY STATUS: NO KEY DEPRESSED
;
;THE FOLLOWING BYTES ARE NOT INITIALIZED
KBYTE	EQU	KSTAT+1	 ;28  LAST DEPRESSED KEY
CLOCK	EQU	KBYTE+1	 ;29  4 BYTES LONG 60 HZ CLOCK
RESULT	EQU	CLOCK+4	 ;2D  FLOPPY RESULT BYTES
XEBEC	EQU	RESULT	 ; OR HARD DISK PAR BLOCK
;5 NONINITALIZED BYTES ARE RESERVED
	.DEPHASE
INTTAB:
	.PHASE INTVEC
;CTC1 INTERRUPTS
;==============================================
;THE 1ST ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееWORD GIVES THE INTERFACE TO THE USER ;
;OF THE BIOS, BECAUSE THIS CTC IS USED FOR    ;
;CLOCK GENERATOR AND MAKES NO INTERRUPT	      ;
;=============================================
	DEFW DRIVE	;PAR BLOCK ADDR FOR CP/M
	DEFW RETIN
	DEFW RETIN
	DEFW ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее