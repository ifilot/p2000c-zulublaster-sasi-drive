.Z80
DUMMY	EQU 0
;********** EQUATES **********
;**********         **********
;
DMA	EQU 0
INTPOR	EQU 10H	;INTR ON COMM SIO INP
USARTі	EQХ 14И	;PRINTER
SASIDA	EQU 16H
SASICO  EQU 18H
REQ	EQU 0	;BIT-0
BUSY	EQU 3	;BIT-3
FDSTAT	EQU 1AH
FDDAT	EQU RESADR	EQU NBSEC+1	;ADDR OF 'RESULT' FIELD
RESULT	EQU RESADR+2	;INTERNAL RESULT BYTES
DSKFLG	EQU RESULT+7	;ADDRESS OF DISKFLAG
NOTRDY	EQU 4		;BIT-4
NOTRES	EQU 10H
MOTON	EQU 20H		;BIT-5
MOTSWO	EQU 40H		;BIT-6
SASINT	EQU 80H		;BIT-7
;
DMADR	EQU DSKF1BH
MEMMGR	EQU 1EH
FDCWRO	EQU 1FH
CTC1	EQU 20H
CTC2	EQU 24H
SIO	EQU 28H
IEC	EQU 0FEH	;IEC PORT
MEXTP	EQU 0FFH	;MEM EXTENSION
PAR	EQU 0FFD0H ;ADDR OF PARAMETER BLOCK
SIIVEC	EQU 0FFECH
DINIT	EQU 0A00H	;DEBUGGER INIT
LINLGT	EQU 50H
NATLGT	EQU 93		LG+2	;ADDR OF DMA SHADOW BYTE
RANDOM	EQU DMADR+2	;RANDOM WORD
;
SPS	EQU RANDOM+2	;STACK POINTER SAVE
TRESUL	EQU SPS+2	;MODIF. TRACK RESULT
STR1M	EQU TRESUL+1	;MODIF STAT REG-1
DERCOD	EQU STR1M+1
PRBYTE	EQU DERCOD+1	;READY STATUS
DRBYT	EQU PRBYTE+1	;NUMBER OF KEYS
L00	EQU 000H
L01	EQU L00+1*LINLGT
L02	EQU L00+2*LINLGT
L03	EQU L00+3*LINLGT
L04	EQU L00+4*LINLGT
L05	EQU L00+5*LINLGT
L06	EQU L00+6*LINLGT
L07	EQU L00+7*LINLGT
L08	EQU L00+8*LINLGT
L09	EQU L00+9*LINLGT
L10	EQU L00+10*LINLGT
L11	;DRIVE AT WRITE TIMR
DSTACK	EQU DRBYT+1	;STACK FOR DISK HANDL
DRITAB	EQU DSTACK+16H
;
;EQUS FOR MEMORY TEST
TBYTE	EQU DRITAB+4
SPSTOR	EQU TBYTE+2
MPASS	EQU SPSTOR+2
SOUADR	EQU MPASS+2
DISADR	EQU SOUADR+2
COMADR	EQU DISADR+2
DMABTE	EQU COMADR+2
EQU L00+11*LINLGT
L12	EQU L00+12*LINLGT
L13	EQU L00+13*LINLGT
L14	EQU L00+14*LINLGT
L15	EQU L00+15*LINLGT
L16	EQU L00+16*LINLGT
L17	EQU L00+17*LINLGT
L18	EQU L00+18*LINLGT
L19	EQU L00+19*LINLGT
L20	EQU L00+20*LINLGT
L21	EQU L00+21*LINLGT
L22	EQUFORBUF	EQU DSTACK+16H	;FORMAT BUFFER
;
;DEBUGGER EQUS
DEBRAM	EQU DSTACK+16H
CURS	EQU DEBRAM
ISA	EQU DEBRAM+1
LINBEG	EQU ISA+2
INBUFF	EQU LINBEG+2	;LGTH=50H!
;
SHADOW	EQU 03800H	;SHADOW SCREEN
WORBUF	EQU SHADOW+7E0H
;
DISBUF	EQU 4000H
AUXBUF	EQ L00+22*LINLGT
L23	EQU L00+23*LINLGT
;
;
;CHARACTERS
CR	EQU 0DH
ESC	EQU 1BH
LF	EQU 0AH
BSP	EQU 08H
CRLF	EQU 0A0DH
DELINE	EQU 08FH
DELSCR	EQU 00CH
;
;THE FOLLOWING VARIABLES ARE IN SYST RANGE 
;AND PRESERVED DURING MEMORY TEST ;;;;;;;;;

;DIU 5000H
X0	EQU 00
X1	EQU 01
X2	EQU 02
X3	EQU 03
X4	EQU 04
X5	EQU 05
X6	EQU 06
X7	EQU 07
X8	EQU 08
X9	EQU 09
X12	EQU 12
X14	EQU 14
X15	EQU 15
Y2	EQU 2
Y3	EQU 3
;
;MISCELLENOUS
;
TESCOD	EQU 0C9H	;FOR MEMORY TEST
KEYNUM	EQU 93		;NUMBER OF SK PARAMETER TO UPDATE BEFORE EACH PROC
DRIVE	EQU 3000H	;ACTUAL FL DRIVE (0-3) 
TRACK	EQU DRIVE+1	;ACTUAL TRACK
SECTOR	EQU DRIVE+3	;ACTUAL SECTOR
HEAD	EQU DRIVE+4	;ACTUAL HEAD
RWBUFF	EQU DRIVE+5	;READ-WRITE BUFF ADDR
RWLGT	EQU DRIVE+7	;READ-WRITE LENKEYS
KTLGT	EQU 90		;LGT OF 1 PAGE OF KEYT
ZERO	EQU	0
PREND	EQU	3580H
BIOS	EQU	0F600H
BIOSLGT	EQU	-BIOS	;=0A00H
SHIFT	EQU	0C000H
BDOS	EQU	5
SH1	EQU	0E0H
SH2	EQU	0EBH	;SUPERSHIFT VALUES
KTLGT	EQU	90	;KEY TABLE LENGT

GTH
TXPOIN	EQU DRIVE+9	;TEXT POINTER
BADOPC	EQU TXPOIN+2	;NUMBER OF BAD OPR
TOTERC	EQU BADOPC+2	;TOTAL NUMBER OF ERRORS
TESPAT	EQU TOTERC+2	;=81H IF TEST PATTERN (WITH DB6)
DRPT	EQU TESPAT+1	;POINTER TO NEXT DRIVE
DRLIST	EQU DRPT+2	;LIST OF DRIVES
Sееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее