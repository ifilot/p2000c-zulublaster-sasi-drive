
LASTEX:	CALL	DELLST
	LD	DE,L22
	JR	TX3
OPRTEX:	CALL	DELCON	;DELETE CONTROL LINE
	LD	DE,L23
;
;DISPLAY TEXT GIVEN BY SERIAL NUMBER
;INTERFACE AS AT TX2
TX3:	POP	HL
	INC	HL
	PUSH	HL
	CALL	GETEXT
	JR	TX1
;
TX1:	CALL	SCRPOS	;POSIT TO DE
	PUSH	PUSH	AF
	EX	DE,HL
	CALL	SCRPOS
	EX	DE,HL
	LD	A,'C'
SETC1:	CALL	ESCAPE
	POP	AF
	RET
;
;RESET CURSOR
RESCUR:	PUSH	AF
	LD	A,63H
	JR	SETC1
;
;WRITE TO VIDEO	ESC, '0' AND THEN (ACC)
ESCAP0:	PUSH	AF
	LD	A,'0'
	CALL	ESCAPE
	POP	AF
	JR	VIDOUT
;AF
	LD	A,(HL)	;LENGTH
	AND	A
	PUSH	BC
	JR	NZ,TX10
	CALL	BEEP
	CALL	GETKEY
	RSװ	°	;° LENGTH, PROGR ERR
TX10:	PUSH	HL
	LD	H,0
	LD	L,A
	ADִ	HL,DE
	INC	HL
	EX	(SP),HL
	LD	B,(HL)
	INC	HL
TX11:	LD	A,(HL)
	INC	HL
	CALL	VIDOUT
	DJNZ	TX11
	LD	A,
;WRITE TO VIDEO ESC AND THEN (ACC)
ESCAPE:	PUSH	AF
	LD	A,ESC
	CALL	VIDOUT
	POP	AF
	JR	VIDOUT
;
CLSCR:	LD	A,0CH
	JR	VIDOUT
;
;SCREEN OUT TO (DE)
SCRODE:	CALL	SCRPOS
;
;FILTER CONTROL CHAR BEFORE LET TO VIDEO
VIDASC:	CP	' '
	JR	NC,VIDOUT
	L20H
	CALL	VIDOUT
	POP	DE
	POP	BC
TX12:	POP	AF
	RET
;
TENSP:	LD	HL,SPACES
	JR	TX1
SPACES:	DEFB	10
	DEFM	'          '
;
;GET TEXT START ADDR
;ENTRY:	TEXT SERIAL NUMBER IS DEPOSITED
;	IN THE BYTE AFTER 'CALL TX2'
;EXIT:	HL = TEXT START ADDR
TXD	A,' '	;REPLACE WITH SPACE
;
;OUTPUT TO VIDEO
VIDOUT:	PUSH	BC
	PUSH	AF
	LD	BC,9
	CALL	BIOSCAL
	POP	AF
	POP	BC
	RET
;
BIOSCAL: PUSH	HL
	PUSH	DE
WBADR	EQU	$+1	;WARM BOOT ADR
	LD	HL,0
	ADD	HL,BC
	LD	C,A
	CALL	JPHL
	POP	DE
	POP	HL
RETLF:	R2:	POP	HL
	INC	HL
	PUSH	HL		;MODIF RET ADDR
;
;GET THE REQUIRED TEXT LINE
;ENTRY: HL POINTS 1 POS AFTER TEXT NUMBER
;EXIT:	HL POINTS TO TEXT LINE
GETEXT:	PUSH	AF
	DEC	HL
	LD	A,(HL)
	CALL	TXSEEK
	POP	AF
	RET
;
;GET THE START ADDR OF A GIVEN TEET		;NO PRINTING
JPHL:	JP	(HL)
;
SCRPOS:	PUSH	HL
	PUSH	DE
	PUSH	BC
	PUSH	AF
	EX	DE,HL
	LD	A,'Y'
	CALL	ESCAPE
	LD	B,1FH
	LD	DE,-50H
SCRP1:	INC	B
	ADD	HL,DE
	JR	C,SCRP1
	LD	A,B
	CALL	VIDOUT	;ROW
	LD	A,L
	ADD	A,70H
	CALL	VIDOUT	;COLUMN
POPXT
TXSEEK:	LD	HL,(TXSTART)
TXS0:	PUSH	BC
	LD	B,0
	INC	A
TXS1:	DEC	A
	JR	Z,TXS2
	LD	C,(HL)
	INC	HL
	ADD	HL,BC
	JR	TXS1
TXS2:	POP	BC
	RET
;;
CONVRT:	AND	0FH		;
	OR	30H		;CONVERT TO ASCII
	CP	3AH		;
	RET	C		;
	ADD	A,7		;
	RET		;
;
;KEYIN:S:	POP	AF
	POP	BC
	POP	DE
	POP	HL
	RET
;
;SCREEN	OUT FROM (HL)
SCROHL:	EX	DE,HL
	CALL	SCRODE
	EX	DE,HL
	RET
;
SCRDEL:	PUSH	AF
	CALL	SCRPOS
	LD	A,'K'
	CALL	ESCAPE	;DELETE TO END OF LINE
	POP	AF
	RET
;
;SCROLLING UP
SCROLL:	PUSH	AF
	PUSH	CALL	SETCUR
;	CALL	GETKEY
;	CALL	RESCUR
;	RET
;
;
DELLST:	PUSH	DE
	PUSH	AF
	LD	DE,L22
DELL1:	CALL	SCRPOS
	LD	A,'K'
	CALּ	ESCAPE
	POP	AF
	POP	DE
	RET
DELCON:	PUSH	DE
	PUSH	AF
	LD	DE,L23
	JR	DELL1
;
;
DISBYT:	PUSH	AF		;DISP HEXA BYTE
		DE
	LD	DE,L23
	LD	A,CR
	CALL	SCRODE
	LD	A,LF
	CALL	VIDOUT
	POP	DE
	POP	AF
	RET
;
BEEP:	PUSH	AF
	LD	A,07
	CALL	VIDOUT
	POP	AF
	RET
;
INIKEY:	PUSH	BC
	LD	B,0
INIK1:	EX	(SP),HL
	DJNZ	INIK1
	POP	BC
	CALL	KEYST
	JR	NZ,INIKEY
	RET
;
KEYRRCA
	RRCA
	RRCA
	RRCA
	CALL	DISHX
	POP	AF
DISHX:	CALL	CONVRT
	CALL	SCRODE
	INC	DE
	RET
;
;SUBR TO DISPLAY 4DIGIT DEC NUMBER
DEC4:	PUSH	BC	;INPUT IN HL
	SUB	A
	DEC	A
DEC45:	INC	A
	LD	BC,100
	SBC	HL,BC
	JR	NC,DEC45
	ADD	HL,BC
	POP	BC
	AST:	PUSH	BC
	LD	BC,3
	CALL	BIOSCAL
	POP	BC
	AND	A
	RET	Z
;
GETKEY:	PUSH	BC
	LD	BC,6
	CALL	BIOSCAL
	POP	BC
	RET	NZ
	CP	1	;SET NONZERO
	RET
;
DELAY:	PUSH	BC
	LD	BC,0
DEL00:	DJNZ	DEL00
	DEC	C
	JR	NZ,DEL00
	POP	BC
	RET
;
;
DEL:	LD	A,B
ND	A
	CALL	NZ,DECNUM
	LD	A,L
;
DECNUM:	PUSH	BC
	LD	C,0FFH
DN1:	INC	C
	SUB	10
	JR	NC,DN1
	ADD	A,10
	PUSH	AF
	LD	A,C
	ADD	A,'0'
	CALL	SCRODE
	INC	DE
	POP	AF
	ADD	A,'0'
	CALL	SCRODE
	INC	DE
	POP	BC
	RET
;
;
;SET CURSOR ON (HL)
SETCUR:		OR	C
	RET	Z
	LD	(HL),0
	DEC	BC
	INC	HL
	JR	DEL
;
LASPRI:	RET
ANYKEY:	LD	DE,L23
	CALL	SCRDEL
	CALL	TX3
	DEFB	2BH	;'ENTER ANY KEY ..'
	CALL	GETKEY
	RET
;
;MENSU0 PRINTS THE MESSAGE
;'TO ESCAPE TYPE 0'
;AND EXECUTE MENSUB
;
MENSU0:	PUSH	DE
	LD	DE,L23
	CALL	TX3
	DEFB	2EH	;TO ESCAPE 'ESC' OR '0'	
	POP	DE
;
;MENSUB PRINTS B+1 TEXT LINES
;AND INPUTS A NUMBER 0 TO B
;
MENSUB:
	RES	1,(IX+X14)	;ENABLE PRINTING
	POP	HL
	INC	HL
	PUSH	HL		;MODIF RET ADDR
	CALL	SCRPOS
	CALL	GETEXT
	PUSווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווH	BC
	PUSH	DE		;START OF MAIN LINE
	CALL	TX1
	LD	A,'1'
	EX	DE,HL
	EX	(SP),HL	;CURSOR POSITION
	EX	DE,HL
MENS4:	PUSH	HL
	LD	HL,LINLGT
	ADD	HL,DE
	POP	DE
	PUSH	HL	;NEXT LINE START POS
	CALL	SCROHL	;NUMBER OF OPTIONS
	INC	A
	INC	HL
	INC	HL
	PUווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווSH	AF
	LD	A,'-'
	CALL	SCROHL
	POP	AF
	INC	HL
	INC	HL
	EX	DE,HL
	CALL	TX1	;DISPLAY TEXT
	POP	DE		;START OF LINE
	DJNZ	MENS4
	POP	HL
MENS3:	CALL	SETCUR
	CALL	GETKEY
	POP	BC
	SUB	ESC
	RET	Z
	ADD	A,ESC
	CALL	SCROHL
	SUB	'0'
	JR	C,MENS1
	CP	ווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווB
	RET	C
	RET	Z
MENS1:	CALL	BEEP
	PUSH	BC
	JR	MENS3
;
M2:	PUSH	HL
	PUSH	AF
	CALL	SETCUR
	POP	AF
	POP	HL
	PUSH	DE
	INC	A
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	DEC	A
	JR	NZ,$-5
	EX	DE,HL
	POP	DE
	JP	(HL)		;JUMP TO SUBR
;
;SUBR TO ASKוווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווו