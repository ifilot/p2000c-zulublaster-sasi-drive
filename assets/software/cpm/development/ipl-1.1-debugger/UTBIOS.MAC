
	.Z80
CPJPT:	DEFS	18
	JP	SELDSK	;SELECT DISK
	JP	SETTRK	;SET TRACK NUMBER
	JP	SETSEC	;SET SECTOR NUMBER
	JP	SETDMA	;SET DMA ADDRESS
	JP	CREAD	;READ DISK
	JP	CWRITE	;WRITE DISK
;
;==============================================
;WRITE WITH DEBLOC=====================
NEWSEC:	LD	HL,CDRIVE	;OLD VALUES
	LD	DE,CPMBLK	;NEW VALUES
	LD	B,5
NWS1:	LD	A,(DE)
	CP	(HL)
	INC	DE
	INC	HL
	RET	NZ		;NOT OLD
	DJNZ	NWS1
	RET			;SAME
;
;==============================================
;READ ONE CP/M SECTORKING			      ;
;IF NEW PHYSICAL SECTOR, COMPLETE OLD WRITE   ;
;TRANSFER DATA TO THE CORRESP. BUFADR RANGE   ;
;AND MARK WHICH PART OF BUFADR IS VALID	      ;
;=============================================
CWRITE:	PUSH	BC
	CALL	TRTRANS	;TRANSFORM DR,			      ;
;IF A NEW PHYSICAL SECTOR IS REQUIRED, THE    ;
;EVENTUAL WRITING OF THE OLD ONE IS COMPLETED ;
;IF THE REQU. CP/M SECTOR IS NOT YET IN BUFFER;
;THE PHYSICAL SECTOR IS READ, OTHERWISE ONLY  ;
;TRANSFERRED TO THE DMA ADDRESS		      ;
;IF THTR
	CALL	NEWSEC
	LD	A,(BUFFLG)
	JR	Z,WR1	;OLD PHYSICAL SECTOR
	CALL	WRCOMPL	;COMPLETE OLD WRITE IF ANY
	POP	BC
	RET	NZ	;IF ERROR
	PUSH	BC
	LD	A,3	;BOTH HALFS INVALID
WR1:	POP	BC
	DEC	C	;DIRECTORY WRITE?
	JR	NZ,WR15
	SET	6,A	;IMMEDIATE WRITE
WRE FIRST DIRECTORY SECTOR IS REQUIRED    ;
;A PHYSICAL READ TAKES PLACE ANYWAY TO PREVENT;
;ERRORS IF DISK HAS BEEN CHANGED	      ;
;==============================================
CREAD:	CALL	TRTRANS	    ;TRANSFORM DR,TR,HD
	LD	A,(CPMSEC)
	DEC	A
	JR	15:	SET	7,A	;DO WRITE SOMETIMES
	LD	(BUFFLG),A
	CALL	CTRANSF	;PREPARE BC DE AND HL
	LDIR
	LD	A,-2	;IF ODD SECTOR
	JR	NZ,WR2
	DEC	A	;EVEN SECTOR
WR2:	LD	HL,BUFFLG
	AND	(HL)	;RESET THE CORRESP FLAG
	BIT	6,A
	RES	6,A	;IMMEDIATE WRITE?
	LD	(HL),A
	NZ,RDA1		;NOT 1ST SECT
;SEE IF DIRECTORY TRACK
	LD	HL,(PARBLK)
	LD	BC,0AH
	ADD	HL,BC		;GET DESCR
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	HL,0DH		;GET TRACK OFF
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	LD	HL,(CPMTR)	;CPM TRACK
	SBC	HL,DE		;NO CARRYLD	A,0
	RET	Z	;NO
;
;==============================================
;COMPLETE WRITE OPERATION IF ANY	      ;
;ACTION: IF NO WRITE REQUIRED SKIP WRITING    ;
;IF THE PHYSICAL SECTOR IS NOT COMPLETELY VALID
;DO PRE-READ BEFORE WRITING		      ;
;UPDAT
;IF THE 1ST DIRECTORY SECT, READ ALWAYS!
	JR	Z,CRD1
RDA1:	CALL	NEWSEC
	JR	NZ,CRD1	;NEW SECT, MUST READ!
;
;OLD SECTOR, SEE IF VALID CP/M SECT PRESENT
	LD	HL,CPMSEC
	LD	A,1	;MASK FOR ODD SECTORS
	BIT	0,(HL)	;SECTOR
	JR	NZ,RD0
	INC	A	;MASK FOR EVE PHYSICAL PARAMETER (DRIVE, TRACK, SECT)
;==============================================
WRCOMPL: LD	HL,BUFFLG
	BIT	7,(HL)	;DO WRITE?
	RES	7,(HL)	;NOW WRITTEN
	JR	Z,PARUPD ;NOTHING TO WRITE
	CALL	PREREAD	;READ IF NECESSARY
	RET	NZ	;ERROR!
WRC2:	CAEN SECTORS
RD0:	LD	HL,BUFFLG
	AND	(HL)
	CALL	NZ,PREREAD ;READ IF NECESSARY
	RET	NZ	;IF ERROR
	JR	RD2	;TRANSFER
;
CRD1:	CALL	WRCOMPL
	RET	NZ
	CALL	READSEC
	LD	HL,BUFFLG
	LD	(HL),3	;BOTH HALFS INVALID IF BAD
	RET	NZ
	LD	(HL),0	;BOTH VALID IF OKLL	WRITSEC	;WRITE SECTOR
	RET	NZ	;ERROR
;
;=============================================
;UPDATE DRIVER PARAMETER FROM THE CP/M ONES  ;
;(DRIVE, TRACK, SECTOR)			     ;
;=============================================
PARUPD:	LD	DE,CDRIVE
	LD	HL,CPMB
	LD	(BUFFLG),A	;ALL VALID, NO WRITE
RD2:	CALL	CTRANSF	;PREPARE REGS FOR TRANSFER
	EX	DE,HL	;OPPOSITE DIR AS WRITE
	LDIR
	XOR	A	;NO ERROR
	RET
;
CTRANSF:	LD	HL,(DMADDR)	;SOURCE AT WRITE
	LD	DE,BUFADR	;DEST AT WRITE
	LD	A,(CPMSEC)
	BIT	0,A	;ODD ORLK
	LD	BC,5
	LDIR
	XOR	A	;NO ERROR
	RET
;
;=============================================
;CHECK IF A NEW PHYSICAL SECTOR IS ADDRESSED?;
;COMPARE DRIVE,TRACK,SECTOR,HEAD	     ;	
;ON EXIT ZERO FLAG IS SET IF OLD ONE	     ;
;======================== EVEN CP/M SECTOR?
	JR	NZ,TRANF1
	LD	DE,BUFADR+80H
TRANF1:	LD	BC,80H
	RET
;
PREREAD: LD	HL,BUFFLG
	LD	A,(HL)
	AND	3
	RET	Z	;ALL CP/M SECTORS VALID
	PUSH	HL
	LD	HL,BUFADR ;SAVE 1ST CP/M SECTOR?
	RRA
	JR	NC,PRRD1 ;YES, 1ST IS VALID
	LD	HL,BUFADR+80H ;SECOND HALF IS VALID
PRRD1:	LD	DE,EXBUF ;EXTRA 80H BYTE BUFFER
	LD	BC,80H
	PUSH	HL
	PUSH	DE
	PUSH	BC	;SAVE TRANSFER VALUES
	LDIR
	CALL	READSEC
	POP	BC
	POP	HL
	POP	DE
	LDIR		;TRANSFER BACK VALID PART
	POP	HL	;BUFFLG
	RET	NZ	;ERROR
	LD	AVE
	RET
;
READSEC: LD	BC,9
	CALL	RWS
	RET	NZ	;ERROR
;
;IF DIRECTORY READ
;	NOTICE THE USER NUMBERS
;IF SOURCE IS 2000M - BASIC AND DIRECTORY READ
;	DOUBLE RECORD COUNTERS
;
	LD	A,(IX+12)
	AND	A	;DIRECTORY READ?
	JR	Z,RDS6	;NOTHING TO DO
	LDA,(HL)
	AND	0FCH	;NOW ALL SECTS BECAME VALID
	LD	(HL),A
	XOR	A
	RET
;
;I/O DRIVERS FOR THE DISK FOLLOW
;FOR NOW, WE WILL SIMPLY STORE THE PARAMETERS
;FOR USE IN THE READ AND WRITE SUBROUTINES
;
SELDSK:		;SELECT	DISK GIVEN BY REG C
	LD	HL,DEVTAB	B,8
	LD	HL,BUFADR
RDS1:	LD	A,(HL)
	AND	A
	JR	Z,RDS5;ZERO
	CP	20H
	JR	NC,RDS5	;IGNORE
	PUSH	HL
	LD	D,A	;NONZERO USER NUMBER
	LD	HL,USERS
RDS2:	LD	A,(HL)
	AND	A
	JR	Z,RDS3	;STORE HERE
	CP	D
	JR	Z,RDS4	;ALREADY OCCURED
	INC	HL
	JR	RDS2
RDS3:
	LD	A,(HL)
	DEC	A
	CP	C	;MUST BE A LEGAL DRIVE
	JR	C,SELD1	;ELSE RETURN DIRTY
	INC	HL
	LD	B,0
	ADD	HL,BC
	LD	A,(HL)
	CP	80H	;EXISTS?
	JR	NZ,SELD2
SELD1:	OR	0FFH
	LD	HL,0
	RET
SELD2:	LD	(PHYSDR),A; PHYSICAL DRIVE ADDR
;
;DISK NUMBER IS IN TH	LD	(HL),D
RDS4:	POP	HL
RDS5:	LD	DE,20H
	ADD	HL,DE
	DJNZ	RDS1
RDS6:	LD	A,(IX+13)
	SUB	1
	RET	Z	;NORMAL CP/M
;
;CONSIDER THE EXTRAS OF P2000M BASIC
	LD	A,(CDRIVE)
	CP	(IX+6)	;SOURCE READ?
	JR	NZ,RDS9	;NO
	LD	A,(CDRIVE+1)	;TRACK
	AND	A
	JR	NZ,E PROPER RANGE
;COMPUTE PROPER DISK PARAMETER HEADER ADDRESS
	LD	L,C	;L=UNIT NUMBER 0,1
	LD	H,0	;HIGH ORDER ZERO
	ADD	HL,HL	;*2
	ADD	HL,HL	;*4
	ADD	HL,HL	;*8
	ADD	HL,HL	;*16 (SIZE OF EACH HEADER)
	LD	DE,DPBASE
	ADD	HL,DE	;HL= DPBASE(DRIVE*16)
	LDRDS9	;NO DIRECTORY TRACK
	LD	HL,BUFADR
	LD	B,8
RDS8:	LD	DE,0FH
	ADD	HL,DE
	LD	A,(HL)	;GET RECORD COUNTER
	RLCA
	LD	(HL),A	;DOUBLE IT FOR CP/M
	LD	DE,11H
	ADD	HL,DE
	DJNZ	RDS8
RDS9:	SUB	A	;NO ERROR
	RET
;
WRITSEC: LD	BC,11
RWS:	LD	HL,(PAR)
		(PARBLK),HL	;DRIVE PAR BL
	RET
;
HOME:	LD	BC,0	;GO TO TRACK-0
SETTRK:	;SET TRACK GIVEN BY REGISTER C
	LD	(CPMTR),BC
	RET
;
SETSEC:	;SET SECTOR GIVEN BY REGISTER C
	LD	A,C
	LD	(CPMSEC),A
	INC	A
	SRL	A		
	LD	(CPMBLK+3),A
	RET
;
;TRANSFORM ORADD	HL,BC
	LD	C,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,C
	PUSH	HL
	LD	DE,(PAR)
	LD	HL,CDRIVE
	LD	BC,5
	LDIR
	LD	HL,(PAR)
	INC	HL
	LD	IY,TRSU	;FOR DRIVE-A
	LD	A,(CDRIVE)
	AND	3	;STIRP SIDE INFO
	CP	(IX+4)	;DEST?
	JR	Z,RWS1	;YES, NO SPEC
	LD	IY,(TRTRIGINAL CP/M DRIVE,TRACK,SECTOR
;TO PHYSICAL DRIVE, TRACK, SECTOR, HEAD
TRTRANS: LD	C,0	;FOR HEAD
	LD	HL,(CPMTR)
	LD	A,(PHYSDR)
	BIT	2,A
	RES	2,A
	JR	Z,TRTRA1  ;SINGLE SIDED
;
;AT DOUBLE SIDED DRIVES DEVIDE TRACK BY 2
;AND IF CARRY FOUND SET HEAD SU) ;SPEC TRANSL
	LD	A,(IX+9)    ;SOURCE TRACK MULT
	AND	1
	JR	Z,RWS1
	RL	(HL)		;MPY TRACK
RWS1:	POP	HL
	CALL	JPHL	;READ OR WRITE
;
;RESET DRIVER DATA
	LD	HL,(PAR)
	LD	BC,-0DH
	ADD	HL,BC
	LD	(HL),1		;RESTORE 256B/SEC
	AND	A
	RET	Z
	LD	(DSTACTO 1
	SRL	H
	RR	L
	JR	NC,TRTRA1
	INC	C
TRTRA1:	LD	(CPMBLK),A    ;DRIVE
	LD	(CPMBLK+1),HL ;TRACK
	LD	A,C
	LD	(CPMBLK+4),A  ;HEAD
	RET
;
SECTRAN:
;TRANSLATE THE SECTOR GIVEN BY BC USING THE
;TRANSLATE TABLE GIVEN BY DE
	LD	A,D
	OR	E
	JR	NZ,SEK+14H),SP
	LD	SP,DSTACK+14H
	BIT	7,(IX+3)
	SET	7,(IX+3)	;ERROR FLAG
	JR	NZ,RWS2
	CALL	SCROLL
	CALL	LASTEX
	DEFB	2		;DISK ERROR !
	CALL	TX3
	DEFB	13H
	LD	A,(CDRIVE)
	ADD	A,'1'
	CALL	VIDOUT
	CALL	OPRTEX
	DEFB	2EH		;ESC TEXT
RWS2:	CALL	KEYST
	CTR1 ;TABLE EXISTS
	LD	H,B
	LD	L,C	;NO TRANSLATION
	INC	HL	;COMPATIBLE WITH FLOPPY
	RET
SECTR1:	EX	DE,HL	;HL= TRANS TABLE
	ADD	HL,BC
	LD	L,(HL)
	LD	H,0	;NEW SECTOR
	RET		;VALUE IN HL
;
SETDMA:	;SET DMA ADDRESS GIVEN BY REG BC
	LD	(DMADDR),BC	;SCALL	NZ,CHEX
	SUB	A		;NO BDOS MESSG!
	LD	SP,(DSTACK+14H)
	RET
;
DPBASE:	DEFW	TRTABL,0,0,0,DIRBF
DESDES:	DEFW	0,CHK0,ALL0
;
SOUTRT:	DEFW	0,0,0,0,DIRBF
SOUDES:	DEFW	0,CHK1,ALL1
;
TRTABL:	DB 01,02,05,06,09,10,13,14
	DB 17,18,21,22,25,26,29,30
	DB 03,04,07,08,11,12,15,16
	DB 19,20,23,24,27,28,31,32
;
DEVTAB:	DEFB	2	;Ј OF DEVIVES
	DEFS	2	;DRIVE TABLE
CDRIVE:	DEFB	80H,0,0,0,0
;
BUFFLG:	DEFB	3	;NO VALID SECTOR HERE
;BIT7: WRITE NECESSARY, BIT6: IMMEDIATE WRITE
;BIT1: HI-HALF OF BUFADR INVALIDееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее
;BIT0: LO-HALF OF BUFADR INVALID
;
PARBLK:	DEFW	0	;DRIVE PAR BLK
CPMBLK:	DEFB	80H,0,0,0,0 ;CONVERTED DRIVE TR SEC HD
PHYSD