  FDFD    3A FF92        C      	LD	A,(TBUCOU)
  FE00    FE 01          C      	CP	1	;FIRST CHARACTER?
  FE02    20 06          C      
                         C      ;	 A=0  AND ZERO BIT SET IF NOT READY
                         C      ;=============================================
  FE29    DB 15          C      LISTAT:	IN	A,(USART3+1)
  FE2B    E6 85          C      	AND	85H
  FE2	JR	NZ,TTO3	;NO
                         C      ;DMA COUNTER = LGTH OF DMA BLOCK
  FE04    32 FF91        C      	LD	(TDMLGT),A
  FE07    CD FE0D        C      	CALL	TTODMA	;START DMA
  FE0A    FB             C      TTO3:	EI
  FE0B    E1             CD    D6 85          C      	SUB	85H		;READY?
  FE2F    CA FD5D        C      	JP	Z,RETFF
  FE32    97             C      	SUB	A
  FE33    C9             C      	RET		;NO
                         C      ;
                         C      ;==============================================
                         C      ;PRINT ONE OR MORE SCREEN LINES
                         C      ;ON ENTRY: BC = SCREEN ADDRESS (STARTS WITH 0)
                         C      ;	   A  = NUMBER OF LINES
                  =================
                         C      ;INTERRUPT SUBROUTINE FOR DMA
                         C      ;==============================================
  FE55    ED 73 FF3C     C      INTDMA:	LD	(SPSAVE),SP
  FE59    31 FF3C        C      	LD	S       C      ;==============================================
  FE34    21 04C0        C      PRSCR:	LD	HL,PRISCR
  FE37    C3 FDAA        C      	JP	ROMCALL
                         C      ;
                         C      ;===========================P,SPSAVE
  FE5C    F5             C      	PUSH	AF
  FE5D    E5             C      	PUSH	HL
  FE5E    D5             C      	PUSH	DE
  FE5F    C5             C      	PUSH	BC
IPL1.1  83-10-24	MACRO-80 3.44	09-Dec-81	PAGE	1-24
BIOS

  FE60    21 FFB3===================
                         C      ;GET A CHARACTER FROM ANY RAM ADDRESS INTO 'A'
                         C      ;THIS ROUTINE CAN BE CALLED FROM ROM
                         C      ;==============================================
  FE        C      	LD	HL,DMSTAT
  FE63    7E             C      	LD	A,(HL)	;WHICH HAS BEEN BUSY?
  FE64    01 0008        C      	LD	BC,DMA+8
  FE67    ED 41          C      	OUT	(C),B	;SHORT DISABLE
  FE69    ED 40          C      	IN	B,(C)	;GET STATUS B3A    3E 02          C      LDAHL:	LD	A,2
  FE3C    F3             C      	DI
  FE3D    D3 1E          C      	OUT	(MEMMGR),A
  FE3F    7E             C      	LD	A,(HL)
  FE40    F5             C      	PUSH	AF
  FE41    97             C      	SUB	A
 YTE
  FE6B    A8             C      	XOR	B
  FE6C    CD FF04        C      	CALL	IRET	;ENABLE CTC LOGIC
  FE6F    ED 79          C      	OUT	(C),A	;ENABLE CHANNELS NOT RDY
  FE71    77             C      	LD	(HL),A	;SAVE NEW OCCUPATION BYTE
  FE72     FE42    D3 1E          C      	OUT	(MEMMGR),A
  FE44    FB             C      	EI
  FE45    F1             C      	POP	AF
  FE46    C9             C      	RET
                         C      ;
                         C      ;############# INTERRUPT CB 58          C      	BIT	3,B
  FE74    28 1B          C      	JR	Z,DMARET ;NO TERMINAL TRANSFER
                         C      ;
                         C      ;==============================================
                         C      ;VARIABLROUTINES #############
                         C      ;
                         C      ;==============================================
                         C      ;FDC INTERRUPT ROUTINE
                         C      ;===========================ES:   TDMLGT = PREVIOUS DMA LENGTH
                         C      ;	      TBUCOU = BUFFER INPUT POS COUNTER
                         C      ;UPDATE TDMLGT AND TBUCOU
                         C      ;IF NO NEW CHARACTER IN BUFFER THEN EXIT
            ===================
  FE47    E5             C      FDCINT:	PUSH	HL
  FE48    21 FFB2        C      	LD	HL,DSKFLG
  FE4B    CB C6          C      	SET	0,(HL)	;COMPLETED
  FE4D    CB 8E          C      	RES	1,(HL)	;READ/WRITE IS OVER
  FE4F    CB 96                C      ;ELSE MOVE NEW DATA TO BUFFER BEGIN & START DMA
                         C      ;==============================================
  FE76    ED 4B FF91     C      	LD	BC,(TDMLGT)	;B=TBUCOU
  FE7A    78             C      	LD	A,B	
  FE7       C      	RES	2,(HL)	;RESET IS OVER
  FE51    E1             C      	POP	HL
  FE52    FB             C      	EI
  FE53    ED 4D          C      	RETI
                         C      ;
                         C      ;=============================B    91             C      	SUB	C	;HOW MANY NEW CHAR IN BUFF?
  FE7C    67             C      	LD	H,A
  FE7D    6F             C      	LD	L,A
  FE7E    22 FF91        C      	LD	(TDMLGT),HL	;BUFFER STARTS WHERE DMA ENDS
  FE81    28 0E          C      	JR	Z,DMARET	;NO NEW CHARACTER
                         C      ;
  FE83    11 FF3E        C      	LD	DE,TTOBUF	;START OF BUFFER AREA
  FE86    06 00          C      	LD	B,0
  FE88    60             C      	LD	H,B
  FE89    69             C      	LD	L,        C      	JR	NZ,TIM0
IPL1.1  83-10-24	MACRO-80 3.44	09-Dec-81	PAGE	1-25
BIOS

  FEAC    2A FF7E        C      TIM1:	LD	HL,(TBYTE)
  FEAF    2B             C      	DEC	HL
  FEB0    22 FF7E        C      	LD	(TBYTE),HL
  FEB3    7C             C
  FE8A    19             C      	ADD	HL,DE
  FE8B    4F             C      	LD	C,A
  FE8C    ED B0          C      	LDIR		;MOVE DOWN NEW DATA
  FE8E    CD FE0D        C      	CALL	TTODMA	;START DMA
  FE91    C1             C      DMARET:	POP	BC
  FC      	LD	A,H
  FEB4    B5             C      	OR	L
  FEB5    20 25          C      	JR	NZ,TIM9
                         C      ;
  FEB7    21 FFB2        C      	LD	HL,DSKFLG
  FEBA    CB 4E          C      	BIT	1,(HL)	;READ-WRITE OPR?
  FEBC    28E92    D1             C      	POP	DE
  FE93    E1             C      	POP	HL
  FE94    F1             C      	POP	AF
  FE95    ED 7B FF3C     C      	LD	SP,(SPSAVE)
  FE99    FB             C      	EI
  FE9A    C9             C      	RET
             06          C      	JR	Z,TIM3	;NO
                         C      ;
  FEBE    7E             C      	LD	A,(HL)
  FEBF    F6 15          C      	OR	NOTRDY+COMPL+RESET ;DISK,NOT READY!
  FEC1    77             C      	LD	(HL),A
  FEC2    18 18                      C      ;
                         C      ;==============================================
                         C      ;TIMER INTERRUPT APPEARS EVERY 16.6MS. ACTIONS:
                         C      ;1. DECREMENT TIME COUNT AND EXIT IF NO C      	JR	TIM9
                         C      ;
  FEC4    CB 76          C      TIM3:	BIT	6,(HL)	;TRANSIENT FOR MOTOR ON?
  FEC6    CB B6          C      	RES	6,(HL)
  FEC8    28 09          C      	JR	Z,TIM7
  FECA    CB EE          C      	SET	5,NZERO
                         C      ;2. IF RDWR FLAG OF DSKFLG BYTE IS SET, THEN
                         C      ;   SET THE COMPL & NOTREADY FLAGS (DISK NOT
                         C      ;   READY) AND EXIT
                         C      ;3. IF M(HL)	;MOTOR RUNS OK
  FECC    3E 04          C      	LD	A,4
  FECE    32 FF7F        C      	LD	(TBYTE+1),A ;STOP IF NOTHING COMES
  FED1    18 09          C      	JR	TIM9
  FED3    CB AE          C      TIM7:	RES	5,(HL)	;MOTON FLAG
  FED5    7E      OTSWO FLAG IS SET (MOTOR RUN-UP READY)
                         C      ;   THIS FLAG IS RESET AND MOTON FLAG IS SET.
                         C      ;4. IF MOTON FLAG IS SET, RESET IT AND SWITCH
                         C      ;   THE MOTOR OFF
              C      	LD	A,(HL)
  FED6    E6 80          C      	AND	SASINT
  FED8    F6 10          C      	OR	NOTRES
  FEDA    D3 1F          C      	OUT	(FDCWRO),A
                         C      ;
                         C      ;EXTERNAL INTERRUPT ROUTI                  C      ;==============================================
  FE9B    FB             C      TIMER:	EI	;LET HIGHER PRIORITY INTR
  FE9C    F5             C      	PUSH	AF
  FE9D    22 FF2A        C      	LD	(HLSAVE),HL
  FEA0    21 FFC0     NE IS IN RAM !!!
                         C      ;CONSIDER IF PREVIOUSLY IN ROM OR RAM?
  FEDC    3E 02          C      TIM9:	LD	A,2	;SWITCH TO RAM
  FEDE    D3 1E          C      	OUT	(MEMMGR),A
  FEE0    F1             C      	POP	AF	;CPM STACK IS PO   C      	LD	HL,CLOCK
  FEA3    3E 04          C      	LD	A,4
  FEA5    34             C      TIM0:	INC	(HL)
  FEA6    20 04          C      	JR	NZ,TIM1
  FEA8    23             C      	INC	HL
  FEA9    3D             C      	DEC	A
  FEAA    20 F9  OR
  FEE1    CD FFBB        C      	CALL	TINEX-1	;EXTERNAL INTERRUPT
  FEE4    F5             C      	PUSH	AF
  FEE5    3A FFBA        C      	LD	A,(MSWBYT)
  FEE8    D3 1E          C      	OUT	(MEMMGR),A
  FEEA    2A FF2A        C      	LD	HL,(HLSAVE)
  FEED    18 13          C      	JR	KIEX
                         C      ;
                         C      ;==============================================
                         C      ;CONSOLE INTERRUPT ROUTINE IS ENTERED AFTER THE
                           ;VARIABLE INIT VALUES TO BE TRANSFERRED TO RAM
                                ;==============================================
                                ;
                                	.PHASE 0FF80H
  FF80                                    C      ;SIOB HAS RECEIVED A CHARACTER
                         C      ;RTS BIT IS TURNED OFF UNTIL THE PORT IS READ
                         C      ;==============================================
  FEEF    F5             C      CONINT:	PUSH	A RAMBUF:
  FF14                          DSKSP	EQU	RAMBUF-6CH
  FF2A                          HLSAVE	EQU	DSKSP+16H
