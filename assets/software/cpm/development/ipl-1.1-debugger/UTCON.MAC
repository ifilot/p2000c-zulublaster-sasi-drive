;=============================================
;THE CONFIGURATION PART ENABLES THE USER TO
;DECLARE HIS FLOPPY DRIVES AND THE LANGUAGE
;HE WISHES FOR MESSAGES
;
;THE SCREEN TABLE IS NOT UPDATED, I.E THE
;FRENCH MESSAGES ARE DISPLAYED CORRECTLY ONLY
 SELECTED BLOCK
	POP	BC
	EX	DE,HL
	POP	HL
	INC	DE
	LDIR
;
;MOVE DOWN THE NEW LANGUAGE
	LD	HL,DISBUF	;SOURCE
	PUSH	HL
	LD	DE,MSGADR	;DEST
	LD	BC,LGLGT-MSGADR	;FIX LGTH
	ADD	HL,BC
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A	;LENGTH OF LANGUAGE
	AD;ON A FRENCH MACHINE !
;=============================================
;
CONPRO:	CALL	CLSCR
	LD	DE,0
	CALL	TX3
	DEFB	55H		;HEADER
	LD	DE,L02
	CALL	TX3		;WARNING FOR
	DEFB	56H		;PROPER DISK
	LD	DE,L05
	CALL	TX3
	DEFB	17H
	CALL	GETKEX		;GET ONE KD	HL,BC
	PUSH	HL
	POP	BC	;TOTAL LENGTH
	POP	HL
	LDIR
;
;ASK THE USER IF HE WISHES TO KEEP THE
;OTHER WERSIONS
CONPA:	CALL	YESNO
	DEFB	59H	;'KEEP?'
	JR	C,CONP0 ;YES
	LD	A,1
	LD	(LANGUN-MSGADR+DISBUF),A ;ONLY 1 LANGUAGE
;
;=====================EY
	LD	(IX),1		;READ WHOLE
	LD	HL,DISBUF-80H
	CALL	LDMS1		;MSG FILE
;ASK THE USER FOR THE LANGUAGE IF MORE THAN 1
	LD	A,(LANGUN-MSGADR+DISBUF)
	DEC	A
	JP	Z,CONP0		;NO SELECTION
	LD	DE,L07
	CALL	TX3
	DEFB	58H		;'SELCT LANGU'
	LD	A,(LANGUN-MSGADR+========================
;THE USER ENTERS THE DISK CONFIGURATION AND
;THEN THE FILE 'UTIL.MSG' IS WRITTEN BACK
;=============================================
CONP0:	CALL	CLSCR
	LD	DE,0
	CALL	TX3
	DEFB	55H		;HEADER
;
;ASK THE DISK CONFIGURATION
	LDISBUF) ;Ј OF LANGUAGES
	LD	(IX+1),A
	LD	(IX),'1'
	EXX
	LD	DE,L10
	CALL	SCRPOS
	LD	HL,LGLGT-MSGADR+DISBUF	;POINTS TO LGTH
CONP7:	PUSH	AF
	PUSH	HL
	LD	A,(IX)
	CALL	VIDOUT
	LD	A,' '
	CALL	VIDOUT
	LD	A,'-'
	CALL	VIDOUT
	LD	A,' '
	CALL	VIDOUT
D	DE,L08
	CALL	TX3
	DEFB	57H		;EXPLANATION
	LD	B,4
	LD	DE,L13
CONP1:	LD	HL,50H		;NEXT LINE
	ADD	HL,DE
	EX	DE,HL
CONP2:	PUSH	DE		;LINE START
	PUSH	BC
	CALL	TX3
	DEFB	13H		;'DRIVE -'
	LD	A,'5'
	SUB	B
	CALL	VIDOUT		;DRIVE NUMBER
	LD	A,':'
	CAL	LD	C,(HL)
	INC	HL
	LD	B,(HL)		;LANGU LENGTH
	INC	HL
	PUSH	BC
	LD	B,16
CONP8:	LD	A,(HL)
	CALL	VIDOUT
	INC	HL
	DJNZ	CONP8		;DISPL LANGU
	LD	A,CR
	CALL	VIDOUT
	LD	A,LF
	CALL	VIDOUT
	POP	BC
	POP	HL
	ADD	HL,BC
	INC	(IX)
	POP	AF
	DEC	A
	JR	NL	VIDOUT
	LD	A,' '
	CALL	VIDOUT
	CALL	VIDOUT
	CALL	GETKEX
	POP	BC
	POP	DE
	LD	C,A
	SUB	'1'
	CP	3
	JR	C,CONP3
	CALL	BEEP
	JR	CONP2		;WRONG ENTRY
CONP3:	ADD	A,81H		;MAKE STANDARD
	CP	83H
	JR	NZ,CONP4
	OR	0FFH
CONP4:	PUSH	AF
	LD	A,C
	CALL	VZ,CONP7
	EXX		;HL'=1ST FREE LOCATION
;
;IF USER ANSWERS WITH A NUMBER, MAKE CHANGE
	CALL	GETKEX
	SUB	'1'
	JR	Z,CONPA		;SAME AS PREV
	CP	(IX+1)
	JR	NC,CONPA	;NO CHANGE
;
;SHIFT THE REQUIRED TEXT TO THE FIRST POS
;AND SAVE THE FILE ON THE DISK
	LIDOUT
	DJNZ	CONP1
;
;PUT THE RESULTS TO THE DISCON FIELD
	LD	HL,DISCON-MSGADR+DISBUF+7
	LD	B,4
CONP5:	POP	AF
	LD	C,50H		;DOUBLE TR?
	CP	82H
	JR	Z,CONP6
	LD	C,28H		;SINGLE
CONP6:	LD	(HL),C
	DEC	HL
	LD	(HL),A
	DEC	HL
	DJNZ	CONP5
;
;PUT RESULD	HL,LGLGT-MSGADR+DISBUF
CONP9:	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	DEC	HL
	ADD	HL,BC
	DEC	A
	JR	NZ,CONP9
;
;NOW HL HAS THE ADDRESS OF THE SELECTED LANGUAGE
;MOVE IT TO THE FIRST FREE PLACE
	EXX
	PUSH	HL		;1ST FREE LOC
	EXX
	POP	DE
	LD	C,(HL)
	INT TO DISCON
	LD	HL,DISCON+DISBUF-MSGADR
	LD	DE,DISCON
	LD	BC,8
	LDIR
;
;MAKE THE NEW UTIL.MSG.
CONQ1:	LD	DE,FPAR		;DELETE FILE
	LD	C,13H
	CALL	DDOS
	SUB	A
	LD	(FPAR+0EH),A	;CP/M REQUIRES
	LD	(FPAR+20H),A	;REC COUNTER
	LD	DE,FPAR
	LD	C,16H	;MAC	HL
	LD	B,(HL)
	DEC	HL
	PUSH	DE		;NEW LOC
	PUSH	BC
	PUSH	HL
	LDIR
;
;MOVE UP THE LOWER BLOCK
	EX	DE,HL
	DEC	DE
	POP	HL
	PUSH	HL
	LD	BC,LGLGT-MSGADR+DISBUF	;FIRST POS
	AND	A
	SBC	HL,BC
	EX	(SP),HL
	DEC	HL
	POP	BC
	LDDR
;
;MOVE DOWN THEKE FILE
	CALL	DDOS
;
;COMPUTE FILE LENGTH
	LD	HL,LGLGT-MSGADR+DISBUF ;1ST LENGTH INFO
	LD	A,(LANGUN-MSGADR+DISBUF) ;Ј OF LANGUAGES
CONQ2:	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	DEC	HL
	ADD	HL,DE
	DEC	A
	JR	NZ,CONQ2
	LD	BC,DISBUF
	SBC	HL,BC	;HL=FILE LENGTH
	ADD	HL,HL	;H=Ј OF CP/M SECT
	INC	H
	LD	B,H
	SUB	A
	LD	(FPAR+32),A ;REC NUMBER
	LD	DE,FPAR
	LD	HL,DISBUF
	LD	(RDADR),HL
CONFQ3:	PUSH	BC
	LD	DE,(RDADR)
	LD	C,1AH	;SET DMA
	CALL	DDOS
	LD	DE,FPAR
	LD	C,15H	;WRITE 1 SECTOR
	CALL	DDOS
	JR	Zееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее