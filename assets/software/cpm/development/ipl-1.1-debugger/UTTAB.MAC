;
	.SALL
DEFT	MACRO STRING1
	LOCAL	DEFT1
	DEFB	DEFT1-$-1
	DEFB	STRING1
DEFT1:
	ENDM
;
;==============================================
;THIS FILE HAS TWO TABLES:
;1. TABLE FOR 160K DISK DESTINATION
;2. TABLE FOR 640K DISK DESTINATION
;EACH TABLUMBER OF TRACKS
	DEFB	0	;NO TR MULTIPLIER
	DEFB	1	;SECT LGTH = 256 BYTES
	INC	H	;TRANSL SUBR FOR BIOS
	RET
	DEFB	0,0	;TO MAKE UP 4 BYTES
;
	DEFB	2	;2 SUBTABLES
ST21:	DEFB	ST22-ST21 ;LENGTH OF SUBTABLE
	DEFT	'CP/M'	;SUBTABLE NAME
	DEFB	1	;FOR CP/ME HAS FOLLOWING STRUCTURE:
;BYTES	00-01	LENGTH OF THIS TABLE
;	02	NUMBER OF POSISBLE SOURCE DISKS
;	SUBTABLE FOR SOURCE-1
;	.
;	SUBTABLE FOR SOURCE-N
;
;SUBTABLE STRUCTURE:
;	1 BYTE LENGTH OF SOURCE NAME
;	SOURCE NAME
;	1 BYTE FOR SIDE (81=SINGLE
	DEFB 20H,0,3,7,0,83H,0,3FH,0 ;CP/M DES
	DEFB 0C0H,0,10H,0,2,0
	DEFB 01,02,05,06,09,10,13,14 ;TRANSL
	DEFB 17,18,21,22,25,26,29,30
	DEFB 03,04,07,08,11,12,15,16
	DEFB 19,20,23,24,27,28,31,32
;
ST22:	DEFB	ST23-ST22 ;LENGTH OF SUBTABLE
	DEFT	'BASIC 82=DOUBLE)
;	1 BYTE FOR NUMBER OF TRACKS ON DISK
;	1 BYTE FOR TRACK MULTIPLIER: 0=NO 1=YES
;	1 BYTE FOR SECT LENGTH 1=256 2=512 3=1024
;	4 BYTES FOR TRACK NUMBERING SUBROUTINE
;		ON ENTRY: H=PHYSICAL TR£ ON DRIVE
;		ON EXIT: H=LOGICAL TR£ ON DISK
;' ;SUBTABLE NAME
	DEFB	2	;BASIC IN 2000M
	DEFB 20H,0,3,7,0,8BH,0,3FH,0 ;CP/M DES
	DEFB 0C0H,0,10H,0,0,0
	DEFB 01,02,13,14,25,26,05,06
	DEFB 17,18,29,30,09,10,21,22
	DEFB 03,04,15,16,27,28,07,08
	DEFB 19,20,31,32,11,12,23,24
;
ST23:
ST3:
;TABLES 	1 BYTE FOR £ OF SYSTEMS (CP/M, BASIC, UCSD)
;	SYSTEM DESCRIPTOR-1
;	.
;	SYSTEM DESCRIPTOR-N
;
;THE SYSTEM DESCRIPTOR:
;	1 BYTE LENGTH OF SYSTEM DESCRIPTOR
;	1 BYTE LENGTH OF SYSTEM NAME
;	SYSTEM NAME
;	SYSTEM IDENTIFIER 0=UCSD OR TRACK TO TRACK CFOR 640K DESTINATION
DCTAB:	DEFW	ENTAB-DCTAB ;LENGTH OF TABLE
	DEFB	5	    ;5 DISK TYPES
;
;DESCRIPTOR FOR 2000C 640K DISK
DT1:	DEFB	DT2-DT1	;TABLE LENGTH
	DEFT 'P2000C 640K' ;NAME
	DEFB	82H	;FLAG FOR DOUBLE SIDED
	DEFB	50H	;NUMBER OF TRACKS
	DEFB	OPY
;			  1=CP/M
;			  2=BASIC (P2000M)
;	IF UCSD: 2 BYTES FOR FIRST SIDE AND TRACK TO COPY
;		 TRACK AND SIDE CONVERTING SUBROUTINE
;			ENTRY H=TRACK L=SIDE OF SOURCE
;			EXIT  H=TRACK L=SIDE OF DEST
;	IF CP/M: 15 BYTES FOR CP/M DESCRIPTOR
;		 32 0	;NO TR MULTIPLIER
	DEFB	1	;SECT LGTH = 256 BYTES
	RET		;TRANSL SUBR FOR BIOS
	DEFB	0,0,0	;TO MAKE UP 4 BYTES
	DEFB	1	;1 SUBTABLE
DT11:	DEFB	DT12-DT11 ;LENGTH OF SUBTABLE
	DEFB	0	;SUBTABLE NAME
	DEFB	0	;FOR UCSD OR PHYS
	DEFW	0	;TRACK-0 SIDE-0 STABYTES FOR TRANSLATION TABLE
;==============================================
;
;TABLES FOR 160K DESTINATION
SCTAB:	DEFW	DCTAB-SCTAB ;LENGTH OF TABLE
	DEFB	2	    ;2 DISK TYPES
;
;DESCRIPTOR FOR 2000C 160K DISK
ST1:	DEFB	ST2-ST1	;TABLE LENGTH
	DEFT 'RT
	RET		;TRACK REALLOCATION
DT12:
;DESCRIPTOR FOR 2000C 160K DISK
DT2:	DEFB	DT3-DT2	;TABLE LENGTH
	DEFT 'P2000C 160K' ;NAME
	DEFB	81H	;FLAG FOR SINGLE SIDED
	DEFB	28H	;NUMBER OF TRACKS
	DEFB	1	;TR MULTIPLIER ACTIVE
	DEFB	1	;SECT LGTH = 256 BYTESP2000C 160K' ;NAME
	DEFB	81H	;FLAG FOR SINGLE SIDED
	DEFB	28H	;NUMBER OF TRACKS
	DEFB	0	;NO TR MULTIPLIER
	DEFB	1	;SECT LGTH = 256 BYTES
	RET		;TRANSL SUBR FOR BIOS
	DEFB	0,0,0	;TO MAKE UP 4 BYTES
	DEFB	1	;1 SUBTABLE
ST11:	DEFB	ST12-ST11 ;LENGTH OF
	SRL	H
	RET		;TRANSL SUBR FOR BIOS
	DEFB	0	;TO MAKE UP 4 BYTES
;
	DEFB	2	;2 SUBTABLES
DT21:	DEFB	DT22-DT21 ;LENGTH OF SUBTABLE
	DEFT	'CP/M'	;SUBTABLE NAME
	DEFB	1	;FOR CP/M
	DEFB 20H,0,3,7,0,97H,0,3FH,0 ;CP/M DES
	DEFB 0C0H,0,10H,0,2,0
	DEFB 01, SUBTABLE
	DEFB	0	;SUBTABLE NAME
	DEFB	0	;FOR UCSD OR PHYS
	DEFW	0	;TRACK-0 SIDE-0 START
	RET		;TRACK REALLOCATION
ST12:
;DESCRIPTOR FOR 2000M DISK
ST2:	DEFB	ST3-ST2	;TABLE LENGTH
	DEFT 'P2000M'	;NAME
	DEFB	81H	;FLAG FOR SINGLE SIDED
	DEFB	23H	;N02,05,06,09,10,13,14 ;TRANSL
	DEFB 17,18,21,22,25,26,29,30
	DEFB 03,04,07,08,11,12,15,16
	DEFB 19,20,23,24,27,28,31,32
;
DT22:	DEFB	DT23-DT22 ;LENGTH OF SUBTABLE
	DEFT	'p-System'
	DEFB	0	;FOR UCSD
	DEFW	200H	;TRACK-2 SIDE-0 START
	SRL	H
	RL	L
	RET		;TRACK REALLOCATION
DT23:
;DESCRIPTOR FOR 2000M DISK
DT3:	DEFB	DT4-DT3	;TABLE LENGTH
	DEFT 'P2000M'	;NAME
	DEFB	81H	;FLAG FOR SINGLE SIDED
	DEFB	23H	;NUMBER OF TRACKS
	DEFB	1	;TRACK MULTIPLIER ACTIV
	DEFB	1	;SECT LGTH = 256 BYTES
	SRL	H
	INC	,0,5,1FH,3,97H,0,7FH,0 ;CP/M DES
	DEFB 080H,0,20H,0,2,0
	DEFB 01,02,05,06,09,10,13,14 ;TRANSL
	DEFB 17,18,21,22,25,26,29,30
	DEFB 03,04,07,08,11,12,15,16
	DEFB 19,20,23,24,27,28,31,32
;
DT52:	DEFB	DT53-DT52 ;LENGTH OF SUBTABLE
	DEFT	'p-System' ;SUBH	;TRANSL SUBR FOR BIOS
	RET
;
	DEFB	2	;2 SUBTABLES
DT31:	DEFB	DT32-DT31 ;LENGTH OF SUBTABLE
	DEFT	'CP/M'	;SUBTABLE NAME
	DEFB	1	;FOR CP/M
	DEFB 20H,0,3,7,0,83H,0,3FH,0 ;CP/M DES
	DEFB 0C0H,0,10H,0,2,0
	DEFB 01,02,05,06,09,10,13,14 ;TRANSL
	DEFB TABLE NAME
	DEFB	0	;FOR UCSD
	DEFW	1	;TRACK-0 SIDE-1 START
	LD	A,H
	SRL	L	;2ND SIDE?
	JR	NC,$+4
	ADD	A,77
	INC	A
	RRA		;CARRY IF ODD
	RL	L
	LD	H,A
	RET
DT53:
;
;DESCRIPTOR FOR P3500 600K DISK
DT6:	DEFB	DT7-DT6	;TABLE LENGTH
	DEFT 'P3500-CP/17,18,21,22,25,26,29,30
	DEFB 03,04,07,08,11,12,15,16
	DEFB 19,20,23,24,27,28,31,32
;
DT32:	DEFB	DT33-DT32 ;LENGTH OF SUBTABLE
	DEFT	'BASIC' ;SUBTABLE NAME
	DEFB	2	;FOR MODEL-M BASIC
	DEFB 20H,0,3,7,0,8BH,0,3FH,0 ;CP/M DES
	DEFB 0C0H,0,10H,0,0,0
	M' ;NAME
	DEFB	82H	;FLAG FOR SINGLE SIDED
	DEFB	50H	;NUMBER OF TRACKS
	DEFB	0	;NO TRACK MULTIPLIER
	DEFB	1	;SECT LGTH = 256 BYTES
	RET		;TRANSL SUBR FOR BIOS
	DEFB	0,0,0	;DUMMY
;
	DEFB	1	;1 SUBTYPE
DT61:	DEFB	DT62-DT61 ;LENGTH OF SUBTABLE
	DEFT	'DEFB 01,02,13,14,25,26,05,06
	DEFB 17,18,29,30,09,10,21,22
	DEFB 03,04,15,16,27,28,07,08
	DEFB 19,20,31,32,11,12,23,24
;
DT33:
;DESCRIPTOR FOR 2500 300K DISK
DT4:	DEFB	DT5-DT4	;TABLE LENGTH
	DEFT 'P2500 300K' ;NAME
	DEFB	81H	;FLAG FOR SINGLE SIDEDCP/M'	;SUBTABLE NAME
	DEFB	1	;FOR CP/M
	DEFB 20H,0,4,0FH,0,40H,1,7FH,0 ;CP/M DES
	DEFB 0C0H,0,20H,0,0,0
	DEFB 01,02,03,04,05,06,07,08 ;TRANSL
	DEFB 09,10,11,12,13,14,15,16
	DEFB 17,18,19,20,21,22,23,24
	DEFB 25,26,27,28,29,30,31,32
;
DT62:
DT7:

	DEFB	4DH	;NUMBER OF TRACKS
	DEFB	0	;NO TRACK MULTIPLIER
	DEFB	1	;SECT LGTH = 256 BYTES
	INC	H	;TRANSL SUBR FOR BIOS
	RET
	DEFB	0,0	;DUMMY
;
	DEFB	2	;2 SUBTYPES
DT41:	DEFB	DT42-DT41 ;LENGTH OF SUBTABLE
	DEFT	'CP/M'	;SUBTABLE NAME
	DEFB	1	;FOR CENTAB:
ווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווווP/M
	DEFB 20H,0,4,0FH,1,95H,0,3FH,0 ;CP/M DES
	DEFB 080H,0,10H,0,2,0
	DEFB 01,02,05,06,09,10,13,14 ;TRANSL
	DEFB 17,18,21,22,25,26,29,30
	DEFB 03,04,07,08,11,12,15,16
	DEFB 19,20,23,24,27,28,31,32
