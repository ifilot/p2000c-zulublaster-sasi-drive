FLFOR:	CALL	CLSCR
	SUB	A
	LD	(FOSTAT),A	;SAYS READY ST
	LD	DE,0
	CALL	TX3
	DEFB	16H		;HEADER
	LD	A,30H
	OUT	(FDCWRO),A	;SW MOTOR ON
	LD	HL,DRTABLE
	EXX
	LD	DE,L02		;MENU POSITION
	CALL	TX3
	DEFB	10H		;'ENTER DRIVE NUMBERS'
	LD	B,4
FO1:	PUSH	B3
;
;INVERT A BLOCK ON THE SCREEN SHOWING RDY
	LD	A,'P'
	CALL	ESCAP0	;START INVERT
	CALL	FORPOS	;GET SCR POSITION TO DE
	CALL	TX3
	DEFB	19H	;'Ready:'
	LD	A,(DRIVE)
	PUSH	AF
	ADD	A,'1'
	CALL	SCRODE
	LD	A,40H
	CALL	ESCAP0	;STOP INVERT
	POP	AF
C
	CALL	GETDRI		;GET VALID DRI
	LD	A,C
	POP	BC
	JR	NC,FO2		;LEGAL
	CP	0DH-'1'
	JR	Z,FO5		;TERMINATED
	CALL	BEEP
	JR	FO1		;ILLEGAL
;
FO2:	EXX
	LD	(HL),A
	INC	HL
	EXX
	LD	A,20H
	CALL	VIDOUT
	DJNZ	FO1
FO3:	CALL	GETKEX
	CP	0DH
	JR	Z,FO5
	CA;SET THE CORRESPONDING BIT IN 'FOSTAT'
	RLCA
	RLCA
	RLCA
	OR	0C7H	;MAKE 'SET BIT,A' COMD
	LD	(FOSET),A
	LD	HL,FOSTAT
	LD	A,(HL)
FOSET	EQU	$+1
	SET	0,A	;IS MODIFIED!
	LD	(HL),A
;
;IF MORE THAN 1 DRIVES SPECIFIED, CONTINUE
	LD	A,(IX)
	DEC	A
	PLL	BEEP
	JR	FO3
;
FO5:	LD	A,4
	SUB	B
	JP	Z,EXIT		;NOTHING
	LD	(IX),A		;£ OF DRIVES
	LD	DE,L08
	CALL	TX3
	DEFB	11H		;WARNING
	LD	DE,L09
	CALL	TX3
	DEFB	17H		;'ANY KEY'
	CALL	GETKEX
;
FM0:	LD	HL,DRTABLE
	LD	A,(IX)		;COUNTER
	LD	(IX+1),A
FM1OP	HL
	JR	Z,EXIT
	DEC	(IX+1)
	JP	NZ,FM1		;NEXT IN THE LIST
	JP	FM0
;
HERROR:	LD	HL,(DMADR)
	DI
	SUB	A
	OUT	(DMA+8),A
	RES	0,(HL)
	LD	A,(HL)
	OUT	(DMA+8),A
	EI
DSKERR:	LD	DE,L22
	CALL	SCRDEL
	CALL	TX3
	DEFB	2	;'DISK ERROR'
GETOUT:	CALL	ANY:	LD	C,(HL)		;DRIVE NUMBER
	INC	HL
	PUSH	HL
	LD	B,0
	LD	HL,DISCON
	ADD	HL,BC
	ADD	HL,BC
	LD	A,(HL)
;DRIVE PROPERTY IN REG A IS 81H FOR SINGLE SD
;			    82H FOR DOUBLE SD
	RRA
	AND	1
	LD	(SIDEFL),A	;BIT0=1 IF DUBLE SIDED
	LD	A,C
	LD	(DRIVE),AKEY
	JP	CONT
;
EXIT:	LD	DE,L22
	JR	GETOUT
;
;SEE IF ANY OF THE FORMATTED DISKS HAVE BEEN
;REMOVED THROUGH THE WITE PROTECT SIGNAL
FOTES:	LD	A,(DRIVE)
	PUSH	AF
	LD	BC,100H	;B=MASK, C=DRIVE
FOTES1:	LD	HL,FOSTAT
	LD	A,(HL)
	AND	B
	JR	Z,FOTES4 ;N
;
;SEE IF NOT ALREADY FORMATTED
	LD	A,(DRIVE)
	RLCA
	RLCA
	RLCA
	OR	47H	;MAKE 'BIT ?,A' COMD
	LD	(FOASK),A
	LD	A,(FOSTAT)
FOASK	EQU	$+1
	BIT	0,A
	JR	Z,FM15	;OK
;
;ALREADY FORMATTED, WAIT UNTIL OPERATOR ACTS
	PUSH	HL
	CALL	OPRTEX
	DEFB	17HOT FORMATTED
	PUSH	BC
	LD	A,C
	LD	(DRIVE),A
	CALL	STATE	;SEE DRIVE STATUS
	AND	40H	;WR PROTECT?
	JR	Z,FOTES3 ;NO, NOT REMOVED
;
;DISK REMOVED, DELETE INVERTED MESSGE
	CALL	FORPOS	;GET SCREEN POSITION
	LD	B,18
FOTES2:	LD	A,' '
	CALL	SCRODE
	INC	
	CALL	GETKEX
	SUB	A
	LD	(FOSTAT),A
	LD	DE,L13
	CALL	SCRDEL	;DELETE SYSTEM LINE
	POP	HL
;
FM15:	INC	HL
	LD	A,(HL)
	LD	(TRACKN),A
	CALL	OPRTEX
	DEFB	2EH		;TO ESCAPE ...
	LD	A,(DRIVE)
	LD	(FORMBLK+2),A
	CALL	DELAY
	SUB	A
FM3:	LD	(TRACK),A
	DE
	DJNZ	FOTES2
	POP	BC
	PUSH	BC
FOSTAT	EQU	$+1
	LD	A,0
	XOR	B
	LD	(FOSTAT),A
FOTES3:	POP	BC
FOTES4:	INC	C	;NEXT DRIVE
	RLC	B	;NEXT MASK
	LD	A,B
	CP	10H
	JR	NZ,FOTES1
	POP	AF
	LD	(DRIVE),A
	RET
;
;GET THE SCREEN POSITION FOR THE ACTUAL D	LÄ	DE,L11
	CALL	TX3
	DEFB	13H		;'DRIVE'
	LD	A,(DRIVE)
	ADD	A,'1'
	CALL	VIDOUT
	INC	DE
	CALL	TX3
	DEFB	14H		;'TRACK
	LD	A,(TRACK)
	CALL	DECNUM
	LD	A,(SIDEFL)
	LD	(IX+2),A
	SUB	A
FM35:	LD	(HEAD),A
	CALL	FOTES
	LD	(SPS),SP
	CALL	FORMAT
	JR	RIVE
FORPOS:	LD	A,(DRIVE)
	INC	A
	LD	HL,L13-18
	LD	BC,18
FORP1:	ADD	HL,BC
	DEC	A
	JR	NZ,FORP1
	EX	DE,HL
	RET
;
FORMBLK: DEFÂ    6,4DH,1,1,10H,32H,0E5H
;
DRTABLE:	DEFW	0FFFFH,0FFFFH
NZ,HERROR
	CALL	FOTES
	CALL	RDTR		;CHECK IT
	JR	Z,FM5
	INC	A
	JR	Z,GETOUT	;ALREADY DISPL
	JR	HERROR
;
FM5:	LD	A,(HEAD)
	XOR	(IX+2)		;SECOND SIDE?
	JR	NZ,FM35
;
;SEE IF NEXT TRACK
	LD	A,(TRACKN)
	LD	B,A
	LD	A,(TRACK)
	INC	A
	CP	B
	JP	NZ,FM