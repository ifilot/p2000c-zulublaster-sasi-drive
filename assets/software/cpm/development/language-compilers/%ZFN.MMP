LN ;%LN=LN(%X)
 S %F=%X,(%LN,%D)=0 Q:%X'>0
LN2 IF %F'<1 S %F=.5*%F,%D=%D+1 G LN2
LN3 IF %F<.5 S %F=2*%F,%D=%D-1 G LN3
 S %F=(%F-.707107)/(%F+.707107),%LN=%F*%F
 S %LN=+$J((((.598979*%LN+.961471)*%LN+2.88539)*ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее%F+%D-.5)*.693147,1,6)
 K %D,%F Q
 ;
EXP ;%E=%EXP(%X)
 S %E=0,%B=1.4427*%X\1+1 Q:%B>90
 S %E=.693147*%B-%X,%A=.00132988-(.000141316*%E)
 S %A=((%A*%E-.00830136)*%E+.0416574)*%E
 S %E=(((%A-.166665)*%E+.5)*%E-1)*%E+1,%A=2
 IF %B'>0 S %A=.5,%B=-%B
 ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееF %I=1:1:%B S %E=%A*%E
 S %E=+$J(%E,1,6) K %A,%B,%I Q
