PROCEDURE PMESS(MESSAGE:STR64);
BEGIN
	GOTOXY	(STATX,STATY);
	WRITE	(CLREOL,MESSAGE);
	GOTOXY	( XXX+CHR) THEN 
			CASE AORN OF
			ALPHA	: IF CH IN UPCASE THEN GOTCHR ELSE BADCHR;
			INTG	: IF CH IN DIG THEN GOTCHR ELSE BADCHR;
			FPT	: IF CH IN FLOAT THEN
					CASE CH OF
					'-' :	IF LEN(STRINP)<>0 THEN BADCHR
						ELSE GOTCHR ;
					'+' : 	IF LENCNT,YYY);
END;

PROCEDURE CURSOFF;

BEGIN
	WRITE(ESC,'D');
END;

PROCEDURE CURSON;

BEGIN
	WRITE (ESC,'E');
END;

PROCEDURE CURSOR(SCRPOS: INTEGER);
CONST
  LINELEN=79;
  
BEGIN
	XXX:=SCRPOS MOD  LINELEN;
	YYY:=SCRPOS DIV LINELEN;
	GO(STRINP)<>0 THEN BADCHR;
					'.' :	IF FPTCNT<>0 THEN BADCHR 
						ELSE	GOTCHR;
					OTHERWISE GOTCHR;
					END
				ELSE BADCHR;
			ALCHRS: IF CH IN ALNUM THEN
					GOTCHR
				ELSE	BADCHR;
			END;
	UNTIL (CH=^M) OR (STOP=TRUE);
	IF	(LEN(STRINP)TOXY(XXX,YYY);
END;

PROCEDURE REVON; (* REVERSE VIDEO = ALT CHAR SET *)

BEGIN
	WRITE (RVSON);
END;

PROCEDURE REVOFF;

BEGIN
	WRITE (RVSOFF);
END;
	
PROCEDURE CLRSCREEN;
BEGIN
	WRITE	(CLRHOM);
END;

FUNCTION GETIN(NRCHS,SF,AORN :INTEG=0)
	AND	(ATRB='C') THEN
		VALID:=FALSE
	ELSE	VALID:=TRUE;
	IF	NOT VALID THEN 
		PMESS	(CHR($07)+'INPUT REQUIRED');
UNTIL VALID;
CURSOFF;
GETIN:=STRINP;
END;

FUNCTION GETALL(NC,SF: INTEGER; DF : STR40; PR : STR80; OPT : CHAR;
		VAR STOP:BOOLEAER;PROM:STR80;ATRB:CHAR;
		VAR STOP:BOOLEAN):STR64;

(* RETURNS ENTERED ASCII STRING ACCORDING ARGUMENTS *)

VAR
	X,ERRPOS : INTEGER;
	FPTCNT,I : INTEGER;
	STRINP : STR64;
	CH : CHAR;
	VALID : BOOLEAN;
	
PROCEDURE GOTCHR;

BEGIN
	IF CHRCNT<NN):STR64;
VAR
	STRINP: STR64;
	
BEGIN	
	STRINP:=GETIN(NC,SF,ALCHRS,PR,OPT,STOP);
	IF LEN(STRINP)=0 THEN GETALL:=DF ELSE GETALL:=STRINP;
END;

FUNCTION GETINT(NC,SF,DF: INTEGER; PR : STR80; OPT : CHAR;
		VAR STOP:BOOLEAN):INTEGER;
VAR
	ERRPOS,I RCHS THEN
	BEGIN
		IF ATRB <> 'P' THEN WRITE(CH);{DON'T ECHO PASSWORD}
		CHRCNT:=SUCC(CHRCNT);
		INSERT(CH,STRINP,CHRCNT);
		IF (AORN= FPT ) AND (CH='.') THEN FPTCNT:=CHRCNT;
	END;
END;

PROCEDURE BADCHR;
BEGIN
	IF (CH=^H) AND (CHRCNT<>0) THEN
: INTEGER;
	X : REAL;
	STRINP: STR40;
	
BEGIN
  REPEAT
	ERRPOS:=0;
	STRINP:=GETIN(NC,SF,INTG,PR,OPT,STOP);
	IF LEN(STRINP)=0 THEN X:=DF ELSE VAL(STRINP,X,ERRPOS);
  UNTIL (ERRPOS=0) AND (X<=32767);
	GETINT:=TRUNC(X);
END;
	
PROCEDURE DISFOR (N	BEGIN
		IF (FPTCNT<>0) AND (CHRCNT=FPTCNT) THEN FPTCNT:=0;
		IF ATRB <> 'P' THEN WRITE	(^H,PRMCHAR);
		DELETE	(STRINP,CHRCNT,1);
		CHRCNT:=PRED(CHRCNT);
		GOTOXY	(XXX+CHRCNT,YYY);
	END
	ELSE	PMESS(CHR($07)+'INVALID CHARACTER');
END;

BEGIN
REPELINE,STARTL : INTEGER; HEADIN: STR64; PROMPT : STR255);

CONST
  DLIMITER='/';
  
VAR
	I,NOSPCES,L,NV,OV,OLDFL,LT : INTEGER;
	T : STR255;

BEGIN

	GOTOXY	(0,0);
	L:=LEN(PROMPT);
	T:=PROMPT;
	OV:=0;
	OLDFL:=0;
	LT:=LEN(HEADIN)+2;
	IF LT > 2AT (* UNTIL VALID INPUT *)

	CHRCNT:=0;
  	FPTCNT:=0;
	STRINP:='';
	CURSOR	(SF); (* SET XXX,YYY AND POSITION CUSOR *)
	WRITE	(PROM);
	XXX:=XXX+LEN(PROM); 
	IF	(LEN(PROM) > 0) 
	AND	(PROM[1]=ESC) THEN
		XXX:=XXX-2;
	IF ATRB <> 'P' THEN
		FOR I:= THEN
	BEGIN
		NOSPCES:=TRUNC((LINELEN-LT) DIV 2);
		GOTOXY	(NOSPCES,0);
		REVON;
		WRITE	(' ',HEADIN,' ');
		REVOFF;
		GOTOXY	(0,1);
		FOR I:=1 TO LINELEN DO WRITE('-');
	END;
 	IF L<>0 THEN
	BEGIN
		FOR I:=0 TO NLINE-1 DO
		BEGIN
			NV:=POS1 TO NRCHS DO WRITE(PRMCHAR);
	GOTOXY	(XXX,YYY);
	CURSON;
	REPEAT (* UNTIL C/R OR STOP *)
		REPEAT
		UNTIL KEYPRESS;
		PMESS	('');
		READ	(KBD,CH);
		IF CH=CHR($1A) THEN STOP:=TRUE ELSE STOP:=FALSE;
				(* CONTROL Z *)
		IF (CH<>^M) AND (NOT STOP(DLIMITER,T);{	<< DELIM WAS '/'}
			GOTOXY	(PRMCOL,STARTL+I);
			WRITE	(COPY(T,1,NV-1));
			OV:=OV+NV;
			IF (L-OV) > 0 THEN
				T:=COPY(PROMPT,OV+1,L-OV);
		END;
	END;
END;
	
FUNCTION JANEE(PRMT : STR40): BOOLEAN;

VAR
	CH :CHAR;
	STOP:BOOLEAN;

BEGIN
	REPEAT (* UNTIL J/N *)
	CH:=GETALL(1,((STATY-2)*LINELEN)+PRMCOL,' ',CLREOL+PRMT+' [ Y/N ] : ',' ',STOP);
	UNTIL (CH='Y') OR (CH='N') OR (CH='y') OR (CH='n');
	IF (CH='Y') OR (CH='y') THEN JANEE:=TRUE ELSE JANEE:=FALSE;
END;
    
(*****    BAD : BOOLEAN;
    CH : CHAR;
    INPSTR : STR4;

CONST
    FUNPOS = 4 ;

BEGIN
    IF LEN(TITLE)<>0 THEN DISFOR(N,FSTLN,TITLE,PROMPTS);
    IF STATLN='X' THEN STATLN:=MPRS;
    IF LEN(STATLN)<>0 THEN PMESS(STATLN);
    IF (NEXTMENU>N-1) OR ******)
PROCEDURE LSTOUT(CH : CHAR);

(** NEW LIST OUTPUT DRIVER FOR TALLY TAKES CARE OF TABS **)

VAR
    I : INTEGER;

PROCEDURE LPOUT(CH : CHAR);
BEGIN
    BIOS(4,ORD(CH));
END;

BEGIN
    IF COLCNT=1 THEN TABSTOP:=1;
    IF CH<>^I THEN
(NEXTMENU<0) THEN NEXTMENU:=0;
    FOR I:=FSTLN TO FSTLN+N-1 DO
    BEGIN
        GOTOXY(FUNPOS-2,I);
        IF NEXTMENU=I-FSTLN THEN WRITE('* ') ELSE WRITE('  ');
        WRITE('F',I-FSTLN:2);
    END;
    INPSTR:='99'; BAD:=TRUE;
    CURSOFF;
     BEGIN LPOUT(CH); COLCNT:=SUCC(COLCNT); END
    ELSE
    BEGIN
	    IF (TABCNT<=MAXTAB) AND (TABS[TABSTOP]<>0) THEN
	    BEGIN
		FOR I:=1 TO TABS[TABSTOP]-COLCNT DO LPOUT(' ');
		COLCNT:=TABS[TABSTOP];
		TABSTOP:=SUCC(TABSTOP);
	    END;
    EN   REPEAT (* UNTIL C/R *)
      REPEAT 
      UNTIL KEYPRESS; PMESS('');READ(KBD,CH);
      IF (CH IN DIG) OR (CH=ESC) OR (CH=^M) OR (CH=' ') THEN
      BEGIN
        CASE CH OF
        @$1B : BEGIN INPSTR:=''; BAD:=FALSE; END;
        ^M   : BEGIND;

    IF (CH=^M) OR (CH=^J) OR (CH=^L) THEN
    BEGIN
	COLCNT:=1; TABCNT:=1;
    END;

END;

(*********)
FUNCTION TAB(NR : INTEGER): CHAR;

VAR
    I: INTEGER;

BEGIN
    IF TABCNT<=MAXTAB THEN
    BEGIN
	TABS[TABCNT]:=NR;
	TABCNT:=SUC
        	VAL(INPSTR,FUNVAL,ERRPOS);       
		IF (FUNVAL<N) AND (ERRPOS=0) THEN BAD:=FALSE ELSE
		   IF (INPSTR='') OR (INPSTR='99') THEN
		      BEGIN
		          BAD:=FALSE; FUNVAL:=NEXTMENU;
		          NEXTMENU:=SUCC(NEXTMENU);
		          IF NEXC(TABCNT);
    END;
    TAB:=^I;
END;

