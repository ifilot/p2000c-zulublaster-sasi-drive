FUNCTION DRAFT: STR4;

CONST
	SI : CHAR = @15;

BEGIN
    DRAFT:=ESC+'[0y'; (* TALLY *)
ETMENU:=SUCC(NEXTMENU);
	           IF NEXTMENU>N-1 THEN NEXTMENU:=0;
	           GOTOXY(FUNPOS-2,FSTLN+NEXTMENU);WRITE('* ');
		   PMESS(MPRS);
		   BAD:=FALSE;
	       END;
	OTHERWISE INPSTR:=CONCAT(INPSTR,CH);
	END;
      END ELSE BEGIN INPSTR:='ND;

