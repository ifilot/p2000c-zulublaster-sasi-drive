PROCEDURE LPHDR(HDRSTR: STR64; UNDCHR : CHAR);

VAR
    I,I1,I2 : INTEGER;
    SP1,SP2: STR40;

BEGIN
 NCTION KL10: STR4;

CONST
	SI : CHAR = @$4E;

BEGIN
    KL10:=ESC+SI;(*'[1y'; (* TALLY *)
END;

(*****************)
FUNCTION MENU(N,FSTLN: INTEGER; TITLE: STR40; PROMPTS: STR255;
		STATLN: STR80):INTEGER;

VAR
    I,FUNVAL,ERRPOS : INTEGER;
   (* GETCLOCK;     FROM BIOS !!! *)
    FOR I:=1 TO 80 DO WRITE(LST,UNDCHR); WRITELN(LST,'');
    I1:=(66-LEN(HDRSTR)) DIV 2;
    I2:=66-LEN(HDRSTR)-I1;
    SP1:='';SP2:='';
    FOR I:=1 TO I1 DO SP1:=SP1+' ';
    FOR I:=1 TO I2 DO SP2:=SP2+' ';
    WRITELN(LST,SP1,HDRSTR,SP2);
    FOR I:=1 TO 80 DO WRITE(LST,UNDCHR);
END;


PROCEDURE INTVAR;
VAR A,B:INTEGER;
BEGIN
  STATUS:=FALSE;
  WITH ORDER DO
  BEGIN
    ORDERNR:='';
    MODELNR:='';
    ORDERDATUM:='';
    ETIKETTERING:='';
    ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееHANGER:='';
    LEVERDATUM:='';
    AANTAL:='';
    VKP:='';
    KP:='';
    FOR A:=1 TO 6 DO
    FOR B:=1 TO 6 DO KLEURCOMB[A,B]:='';
    FOR A:=1 TO 6 DO AANTALSET[A]:='';
    FOR A:=1 TO 8 DO MATEN[A]:='';
    FOR A:=1 TO 6 DO
    FOR B:=1 TO ееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее