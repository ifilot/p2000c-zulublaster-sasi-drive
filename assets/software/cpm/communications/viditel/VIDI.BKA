	LD	A,(ATTR)
	RES	6,A
	RES	0,A
	LD	(ATTR),A
	JP	DISP1
NO14:	CP	15
	JP	Z,GQUART
	CP	16
	JR	NZ,NO16
	CALL	SETGTB
	LD	A,(ATTR
	JR	Z,LOOP1
	LD	A,(CHTX)
	OUT	(ADATA),A
	JR	LOOP
;
CHTX:	DB	0D

LOOP1:
	IN	A,(ACON)
	AND	1
	CALL	NZ,RCV
	JR	LOOP
RCV:	IN	A,(ADATA)
	AND	7F
	CALL	DISP
	RET
;
DISP:	CP	0C
	JR	NZ,NOCLS
	CALL	DISP1
	CALL	GETCH
	CALL	GETCH
	CALL	GETCH
	)
	SET	6,A
	SET	0,A
