	CP	16
	JP	NZ,NO16
	LD	A,1
	LD	(GRAPH),A
	CALL	SETG
	LD	A,(ATTR)
	SET	6,A
	SET	0,A
	LD	(ATTR),A
	LD	A,(PUTIN)
	CALL	DISP
	RET
NO16:	CP	17
	JP	NZ,T1C
	LD	A,1
	LD	(GRAPH),A
	CALL	SETG
	LD	A,(ATTR)
	RES	6,A
	SET	0,A
	LD	(ATTR),A
	LD	A,(PUTIN)
	CALL	DISP
	RET
T1C:	CP	1C
	JP	NZ,NO1C
	CALL	SETAT
	LD	A,(ATTR)
	RES	4,A
	RES	0,A
	SET	6,A
	LD	(ATTR),A
	CALL	DISP1
	LD	A,(PUTIF
	CALL	SETAT
	LD	A,(ATTR)
	CALL	DISP1
	POP	AF
	CALL	DISP1
	JP	CHC
SETATB:	LD	A,1B
	CALL	DISP1
	LD	A,32
	CALL	DISP1
SETAT:	LD	A,1B
	CALL	DISP1
	LD	A,30
	CALL	DISP1
	RET
ATTR:	DB	40
SETG:	LD	A,1B
	CALL	DISP1
	LD	A,31
	CALL	DISP1
	RET
SN)
	CALL	DISP
	XOR	A
	LD	(BCKSET),A
	JP	FILUP
NO1C:	CP	0C
	JP	NZ,NO1B
	LD	A,20
	JP	DISP
NO17:	CP	0A
	JP	NZ,NOA
	LD	A,(LINE)
	INC	A
	LD	(LINE),A
	CP	18
	JP	M,DLINE
	XOR	A
	LD	(LINE),A
	JP	MOVCUR
DLINE:	LD	A,0A
	JP	DISP1
NOA:	CP	1E
	JP	ETGTB:	CALL	SETG
	JP	SETAT
GETCH:	LD	A,(INBUF)
