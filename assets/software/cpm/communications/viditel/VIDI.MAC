RINBUF:	DB	0
INBUF:	DB	0
NOCHAN:	DB	0
REMROW:	DB	0
REMLIN:	DB	0
BCKSET:	DB	0
PUTIN:	DB	20
GRAPH:	DB	0
COLMSG:	DB	1B,59
