	CALL	SE:	POP	AF
	LD	(PUTIN),A
	PUSH	AF
NOVID:	POP	AF
	CP	0C
	JP	NZ,NOCLS
	CALL	DISP1
	XOR	A
	LD	(ROW),A
	LD	(LINE),A
	CALL	SETATB
	LD	A,40
	LD	(ATTR),A
DISP1:	LD	E,A
	LD	C,2
	CALL	5
	RET
NOCLS:	CP	20
	JP	NC,NO0C
	CP	0
	RET	Z
	CP	0F
	RET	Z
	TG
	LD	A,(ATTR)
	RES	6,A
	RES	0,A
	LD	(ATTR),A
	LD	A,(PUTIN)
	CALL	DISP
	RET
NO14:	CP	15
