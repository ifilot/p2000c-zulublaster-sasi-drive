              ;       THE FOLLOWING TABLE DEFINES THE FILENAME EXTENSIONS FOR
                                ;       FILES THAT ARE NOT TO BE TRANSLATED TO AND FROM EBCDIC.
                                ;       THE TABLE HAS THE SAME FORMAT AS THE RJE  03EC'   0000                          DW      0               ;REQUIRED
                                ;
